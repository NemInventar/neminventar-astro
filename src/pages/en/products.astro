---
// Engelsk produktoversigt (backlog e2c66652): de web-publicerede typer fra v_web_products med engelsk navn og kort tekst.
// Billedet er det samme som på /inventar/ (typeBillede). En type uden engelsk tekst i EN vises ikke, så siden aldrig
// blander sprog. Ny type på sitet → tilføj den i src/lib/engelsk.ts. Typesiderne er på dansk; linket siger det.
import Base from '../../layouts/Base.astro';
import ContactCta from '../../components/ContactCta.astro';
import { getWebProducts, getWebColors } from '../../lib/supabase';
import { cdn } from '../../lib/img';
import { FAM_ORDER, famOf, typeBillede } from '../../lib/catalog';
import { PRODUKT_EN as EN } from '../../lib/engelsk';

const FAM_EN: Record<string, string> = {
  garderober: 'Wardrobes and lockers', skabe: 'Tall cabinets and storage', nicher: 'Niches and benches',
  koekken: 'Kitchenettes', omklaedning: 'Changing rooms and wet rooms', vaegge: 'Walls and acoustics',
};

const [products, colors] = await Promise.all([getWebProducts(), getWebColors()]);
const base = import.meta.env.BASE_URL;
const site = Astro.site!;
const cards = products
  .filter((p) => EN[p.slug])
  .map((p) => {
    const im = typeBillede(p, colors);
    return { ...EN[p.slug], href: `${base}produkter/${p.slug}/`, img: im.img, pos: im.pos, foto: im.foto, fam: famOf(p) };
  })
  .sort((a, b) => FAM_ORDER.indexOf(a.fam) - FAM_ORDER.indexOf(b.fam));
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Fixed furniture from Nem Inventar',
  itemListElement: cards.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, url: new URL(c.href, site).href })),
}];
---
<Base
  lang="en"
  title="Fixed furniture made to measure: all types | Nem Inventar"
  description="Wardrobes, lockers, tall cabinets, benches, kitchen walls, changing-room furniture and acoustic panels, built to measure for schools, sports halls and housing."
  jsonLd={jsonLd}
  alternates={[
    { hreflang: 'da', href: new URL(base + 'inventar/', site).href },
    { hreflang: 'en', href: new URL(base + 'en/products/', site).href },
  ]}>
  <section class="sec inv" id="products"><div class="wrap">
    <div class="sec-head">
      <div>
        <span class="label">Products</span>
        <h1 class="inv-h1">Fixed furniture made to measure. <em>All types.</em></h1>
        <p class="lede">These are the types we build most often. Each one is made to measure: size, number of compartments, material and colour follow the room and the tender. The product pages are in Danish, and we answer questions in English.</p>
      </div>
      <a href={`${base}en/contact/`} class="ulink">Need something else? →</a>
    </div>
    <div class="types expanded">
      {cards.map((c) => (
        <article class="tcard">
          <a class="ph" href={c.href} aria-label={c.name} hreflang="da">
            {c.img && <img src={cdn(c.img, 800)} alt={c.name} style={`--pos:${c.pos}`} loading="lazy" decoding="async" />}
            <span class="ptag">{c.foto ? 'Photo from a delivery' : '3D visualisation'}</span>
          </a>
          <div class="body">
            <span class="kicker">{FAM_EN[c.fam]}</span>
            <h3><a href={c.href} hreflang="da">{c.name}</a></h3>
            <p class="desc">{c.desc}</p>
            <div class="tfoot">
              <span class="made"><b>Made to measure</b> · priced from the drawings</span>
              <a href={c.href} class="order" hreflang="da">Details (Danish) <span class="arr">→</span></a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div></section>

  <ContactCta lang="en" />

  <style>
    .inv-h1{font-size:clamp(36px,4.6vw,64px);margin-top:22px;max-width:20ch}
  </style>
</Base>
