---
// Projekter (ny side, 04-10-2026 — plan: Opus på Milots ønske). Alle offentlige sager som kort, derunder "Dem, vi har
// bygget med": arkitekter og entreprenører med navn + link, hvor sagen tillader det (show_customer_name /
// show_architect_name i case_web), ellers som rolle uden navn. Ingen logoer — kun navn og link. "Projekter" i
// topbjælken peger hertil (før: ankeret #projekter på forsiden).
import Base from '../../layouts/Base.astro';
import Ticker from '../../components/Ticker.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ContactCta from '../../components/ContactCta.astro';
import { getWebCases, type WebCase } from '../../lib/supabase';
import { partnersOf, type Partner } from '../../lib/catalog';

const base = import.meta.env.BASE_URL;
const site = Astro.site!;
const cases = await getWebCases();
const partners = partnersOf(cases);
// sager uden entreprenør overhovedet (aftalen er direkte med bygherren)
const direct = cases.filter((c) => !c.has_contractor);

// Én saglig linje pr. firma: hvad firmaet er, og hvad vi lavede sammen. Holdes her, til der er et felt i data.
const FIRM: Record<string, string> = {
  'Rønnow Arkitekter': 'Arkitektfirma. Skolens faste inventar, fra lockers til tekøkkener.',
  'WE Architecture': 'Arkitektfirma. Bænke, locker-rum og vaskeborde til omklædningen og et tekøkken.',
  'TRANSFORM': 'Arkitektfirma. Garderober med siddenicher og omklædningsmøbler.',
  'Kanneworff & Viuff': 'Arkitektfirma. Børnegarderober, toiletbåse og personaleinventar.',
  'Ason A/S': 'Entreprenørvirksomhed. Skolens faste inventar, i etaper i takt med byggeriet.',
  'Enemærke & Petersen': 'Entreprenørvirksomhed. 230 badeværelsesskabe i kompaktlaminat til 220 boliger.',
  'JSP Byg': 'Entreprenørvirksomhed. Garderober, aflåselige skabe og omklædningsmøbler til skolen.',
  'Halbyg': 'Bygger idrætshaller. 43 skohylder med bænk og beklædning af søjler og bjælke.',
};
const firmLine = (p: Partner, kind: 'architects' | 'contractors') =>
  p.name === 'Ason A/S' && p.cases.length > 1
    ? `Entreprenørvirksomhed. ${p.cases.length === 2 ? 'To' : p.cases.length} sager sammen: ${p.cases.map((c) => c.name).join(' og ')}.`
    : FIRM[p.name] ?? (kind === 'architects' ? 'Arkitektfirma.' : 'Entreprenørvirksomhed.');
const domain = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const roleOf = (kind: 'architects' | 'contractors') => (kind === 'architects' ? 'Arkitekt' : 'Entreprenør');

const GROUPS: { kind: 'architects' | 'contractors'; label: string; intro: string; list: { named: Partner[]; unnamed: WebCase[] } }[] = [
  { kind: 'architects', label: 'Arkitekter', intro: 'Vi gør arkitektens projekt til 3D-model, værkstedstegninger og færdigt inventar.', list: partners.architects },
  { kind: 'contractors', label: 'Entreprenører', intro: 'Vi leverer det faste inventar til entreprenøren, fra tilbud og tegninger til levering på pladsen.', list: partners.contractors },
];

const title = 'Projekter — Nem Inventar';
const description = 'Fast inventar leveret til skoler, daginstitutioner, idrætsanlæg og boliger — og de arkitekter og entreprenører, vi har bygget sammen med.';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Nem Inventar', item: new URL(base, site).href },
    { '@type': 'ListItem', position: 2, name: 'Projekter', item: new URL(base + 'projekter', site).href },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Projekter', itemListElement: cases.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, url: new URL(`${base}projekter/${c.slug}`, site).href })) },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>

  <!-- ============ TOPPEN ============ -->
  <header class="pj-top" id="top"><div class="wrap">
    <span class="label">Projekter</span>
    <h1>Fra en hel skole til 43 <em>skohylder.</em></h1>
    <p class="lede">Fast inventar til skoler, daginstitutioner, idrætsanlæg og boliger, tegnet i 3D og bygget i vores egen produktion. Hver sag har sin egen side med leverance, status og billeder.</p>
    <div class="pj-btns">
      <a href={`${base}kontakt`} class="btn btn-primary">Send tegninger eller udbud <span class="arr">→</span></a>
      <a href="#bygget-med" class="btn btn-ghost">Arkitekter og entreprenører <span class="arr">↓</span></a>
    </div>
  </div></header>

  <Ticker cases={cases} />

  <!-- ============ ALLE SAGER ============ -->
  <section class="sec" id="alle"><div class="wrap">
    <div class="pgrid rv">
      {cases.map((c) => <ProjectCard c={c} />)}
    </div>
    <p class="pj-note rv">Kort mærket "Visualisering" viser 3D fra vores eget tegnesystem. Fotos kommer på, efterhånden som leverancerne bliver fotograferet.</p>
  </div></section>

  <!-- ============ DEM, VI HAR BYGGET MED ============ -->
  <section class="bm" id="bygget-med"><div class="wrap">
    <div class="sec-head rv">
      <div>
        <span class="label">Arkitekter og entreprenører</span>
        <h2>Dem, vi har bygget <em>med.</em></h2>
        <p class="lede">Hvert firma står med de sager, vi har lavet sammen, og et link, så I selv kan slå det op. Vi nævner kun et firma ved navn, når det har givet lov.</p>
      </div>
    </div>

    {GROUPS.map((g) => (
      <div class="bm-group rv">
        <div class="bm-head">
          <span class="label">{g.label}</span>
          <p>{g.intro}</p>
        </div>
        {g.list.named.map((p) => (
          <div class="bm-row">
            <div class="bm-name">
              <b>{p.name}</b>
              {p.url && <a href={p.url} target="_blank" rel="noopener">{domain(p.url)} ↗</a>}
            </div>
            <p class="bm-line">{firmLine(p, g.kind)}</p>
            <div class="bm-cases">
              {p.cases.map((c) => <a href={`${base}projekter/${c.slug}`}><span>{roleOf(g.kind)}</span>{c.name} →</a>)}
            </div>
          </div>
        ))}
        {g.list.unnamed.length > 0 && (
          <div class="bm-row bm-unnamed">
            <div class="bm-name"><b>Uden navn</b><small>navnet følger efter aftale</small></div>
            <p class="bm-line">{g.kind === 'architects' ? 'Arkitektfirmaer på sager, hvor vi endnu ikke har aftalt at nævne navnet.' : 'Entreprenører på sager, hvor vi endnu ikke har aftalt at nævne navnet.'}</p>
            <div class="bm-cases">
              {g.list.unnamed.map((c) => <a href={`${base}projekter/${c.slug}`}><span>{roleOf(g.kind)}</span>{c.name} →</a>)}
            </div>
          </div>
        )}
        {g.kind === 'contractors' && direct.length > 0 && (
          <p class="bm-direct">{direct.map((c) => `På ${c.name} er aftalen direkte med bygherren.`).join(' ')}</p>
        )}
      </div>
    ))}
  </div></section>

  <ContactCta />

  <style>
    .pj-top{padding:64px 0 36px}
    .pj-top h1{font-size:clamp(38px,5.2vw,72px);line-height:1.02;letter-spacing:-.02em;margin-top:22px;max-width:14em}
    .pj-top .lede{font-size:clamp(17px,1.5vw,21px);line-height:1.55;color:var(--ink);margin-top:22px;max-width:36em}
    .pj-btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
    .pj-note{margin-top:22px;font-size:13.5px;color:var(--muted)}
    /* dem, vi har bygget med: rækker, ikke fliser */
    .bm{background:var(--soft);padding:88px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
    .bm-group{margin-top:44px}
    .bm-head{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:32px;align-items:baseline;padding-bottom:14px;border-bottom:1px solid var(--line)}
    .bm-head p{font-size:15px;color:var(--muted);margin:0}
    .bm-row{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,5fr) minmax(0,3fr);gap:32px;padding:24px 0;border-bottom:1px solid var(--line);align-items:start}
    .bm-name b{display:block;font-family:'Archivo',sans-serif;font-weight:600;font-size:24px;line-height:1.15;letter-spacing:-.01em}
    .bm-name a{display:inline-block;margin-top:6px;font-size:14px;color:var(--ink);text-decoration:underline;text-decoration-color:var(--warm);text-underline-offset:3px}
    .bm-name a:hover{color:var(--warm)}
    .bm-name small{display:block;margin-top:6px;font-size:13px;color:var(--muted)}
    .bm-line{font-size:16px;color:var(--muted);line-height:1.6;margin:4px 0 0}
    .bm-cases{display:grid;gap:8px}
    .bm-cases a{display:flex;gap:10px;align-items:baseline;min-height:44px;padding:10px 14px;border:1px solid var(--line);border-radius:12px;background:#fff;font-size:14.5px;font-weight:600;color:var(--ink);text-decoration:none;transition:border-color .2s,transform .35s cubic-bezier(.2,.7,.2,1)}
    .bm-cases a span{font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--warm);font-weight:700}
    .bm-cases a:hover{border-color:var(--warm);transform:translateY(-2px)}
    .bm-unnamed .bm-name b{color:var(--muted);font-weight:500}
    .bm-direct{margin-top:14px;font-size:14px;color:var(--muted)}
    @media(max-width:880px){
      .pj-top{padding:40px 0 24px}
      .pj-top h1{font-size:40px}
      .pj-btns .btn{width:100%;justify-content:center}
      .bm{padding:56px 0}
      .bm-head,.bm-row{grid-template-columns:1fr;gap:12px}
      .bm-row{padding:20px 0}
    }
  </style>
</Base>
