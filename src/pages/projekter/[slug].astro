---
// Projektsiden. Indholdet står i src/components/sider/Sagsside.astro, som også er den engelske (/en/projects/<slug>/).
import Sagsside from '../../components/sider/Sagsside.astro';
import { getWebCases } from '../../lib/supabase';

export async function getStaticPaths() {
  const cases = await getWebCases();
  return cases.map((c) => ({ params: { slug: c.slug }, props: { project: c, cases } }));
}
---
<Sagsside {...Astro.props} />
