---
import Base from '../../layouts/Base.astro';
import { getWebCases, type WebCase } from '../../lib/supabase';
import { cdn } from '../../lib/img';

export async function getStaticPaths() {
  const cases = await getWebCases();
  return cases.map((c) => ({ params: { slug: c.slug }, props: { project: c } }));
}

interface Props { project: WebCase }
const { project } = Astro.props;
const paragraphs = (project.web_story ?? '').split('\n\n').filter(Boolean);
const desc = project.seo_description ?? (project.web_summary ?? '').slice(0, 200);
const base = import.meta.env.BASE_URL;
const gallery = project.gallery ?? [];
// Heroen er et foto hvis den findes i galleriet som 'foto' — ellers en render, og det siger vi.
const heroIsPhoto = gallery.some((g) => g.kind === 'foto' && g.src === project.hero_image_url);
const hasRenders = !heroIsPhoto || gallery.some((g) => g.kind === 'visualisering');
const meta = [
  { k: 'Leverance', v: project.delivery_label },
  { k: 'Entreprenør', v: project.contractor_label },
  ...(project.architect_label ? [{ k: 'Arkitekt', v: project.architect_label }] : []),
  { k: 'Status', v: project.status_label },
];
---
<Base title={project.seo_title} description={desc} image={project.hero_image_url ?? undefined}>
  <section class="case-detail"><div class="wrap">
    <a href={`${base}#projekter`} class="crumb">← Tilbage til projekter</a>
    <span class="status" style="color:var(--warm)">{project.status_live && <span class="dot"></span>}{project.status_label}</span>
    <h1>{project.name}</h1>
    {project.web_summary && <p class="lead">{project.web_summary}</p>}

    {project.hero_image_url && (
      <div class="case-hero"><img src={cdn(project.hero_image_url, 1200)} alt={`${project.name} — ${heroIsPhoto ? 'foto' : 'visualisering'}`} /></div>
    )}

    {paragraphs.length > 0 && (
      <div class="prose" style="max-width:64ch">
        {paragraphs.map((para) => <p>{para}</p>)}
      </div>
    )}

    <div class="case-meta" style={`--cols:${meta.length}`}>
      {meta.map((m) => <div class="cell"><div class="k">{m.k}</div><div class="vv">{m.v}</div></div>)}
    </div>

    {gallery.length > 0 && (
      <div class="case-gallery">
        {gallery.filter((g) => g.src !== project.hero_image_url).map((g) => (
          <figure>
            <img src={cdn(g.src, 900)} alt={g.alt} loading="lazy" />
            <figcaption class="img-tag"><b>{g.kind === 'foto' ? 'Foto fra leverancen' : 'Visualisering'}</b>{g.caption}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {hasRenders && (
      <p class="case-note">Billeder mærket "Visualisering" er 3D-renders — ikke foto af selve leverancen. De udskiftes med projektfotos, når de findes.</p>
    )}

    <div class="detail-cta" style="margin-top:38px">
      <a href="mailto:tilbud@neminventar.dk" class="btn btn-primary">Har I et lignende projekt? <span class="arr">→</span></a>
      <a href={`${base}#katalog`} class="btn btn-ghost">Se arketyperne</a>
    </div>
  </div></section>
</Base>
