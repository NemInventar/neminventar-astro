---
// Om os: hvem vi er (ingeniører, der bygger i træ), holdet og vores egenproduktion — vist med 3D-modellen,
// prøveemnet og processen frem for stedet (intet må afsløre, hvor produktionen ligger; se skill seo).
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ContactCta from '../components/ContactCta.astro';
import { getWebCases } from '../lib/supabase';
import { cdn } from '../lib/img';
import { TEAM } from '../lib/team';
const base = import.meta.env.BASE_URL;
const cases = await getWebCases();
---
<Base
  title="Om os — Nem Inventar"
  description="Nem Inventar er ingeniører, der bygger fast inventar i træ til byggeri. Bygget ordentligt, dokumenteret ordentligt og leveret efter byggepladsens tidsplan.">

  <!-- ============ TOPPEN ============ -->
  <header class="hero2 about2"><div class="wrap hero2-grid">
    <div class="hero2-head">
      <span class="label">Om os</span>
      <h1>Vi er ingeniører, der bygger i <em>træ.</em></h1>
    </div>
    <div class="hero2-cta">
      <a href={`${base}#projekter`} class="btn btn-ghost">Se projekterne <span class="arr">→</span></a>
      <a href={`${base}kontakt`} class="btn btn-primary">Kontakt os <span class="arr">→</span></a>
    </div>
    <div class="duo" aria-label="3D-model og prøveemne">
      <div class="slot a">
        <video class="is-on" src={cdn('/video/3d-model-garderobe.mp4')} poster={cdn('/video/3d-model-garderobe.jpg')} muted playsinline preload="metadata" data-inview data-start="4" aria-label="Skærmoptagelse af 3D-modellen af et garderobemodul" style="--pos:40% 50%"></video>
        <span class="img-tag"><b>3D-modellen</b>det, I godkender, før vi bygger</span>
      </div>
      <div class="slot b">
        <video class="is-on" src={cdn('/video/proeveemne-locker.mp4')} poster={cdn('/video/proeveemne-locker.jpg')} muted playsinline preload="metadata" data-inview aria-label="Prøveemne af en locker i vores egenproduktion"></video>
        <span class="img-tag"><b>Prøveemnet</b>ét eksemplar, før serien bygges</span>
      </div>
    </div>
    <p class="hero2-sub">Nem Inventar laver fast inventar til byggeri — garderober, lockers, bænke, højskabe, tekøkkener og akustik efter tegning. Vi er et ungt hold med en enkel overbevisning: inventar skal bygges ordentligt, dokumenteres ordentligt og leveres, når byggepladsen er klar til det.</p>
    <div class="facts2" aria-label="Kort om os">
      <span class="fact2">Ingeniører</span>
      <span class="fact2">Startet 2024</span>
      <span class="fact2">Tegnet i 3D</span>
      <span class="fact2">Egen produktion</span>
      <span class="fact2">København NV</span>
    </div>
  </div></header>

  <Ticker cases={cases} extra={[{ b: '8–12', t: 'uger', c: 'typisk fra ordre til levering' }]} />

  <!-- ============ TRE TING ============ -->
  <section class="sec" id="saadan-taenker-vi"><div class="wrap">
    <div class="sec-head rv">
      <div>
        <span class="label">Det, vi står for</span>
        <h2>Håndværk, grebet an som <em>ingeniørarbejde.</em></h2>
      </div>
    </div>
    <div class="agrid rv">
      <article>
        <span class="n">I.</span>
        <h3>Vi tænker i mål, tolerancer og montage</h3>
        <p>Vi kommer fra byggeriet, ikke fra møbelbutikken. Det betyder, at vi tænker i mål, tolerancer, materialer og montage fra første tegning. Vi bygger i krydsfiner, kompaktlaminat og massivt træ, med samlinger og overflader, der er valgt efter, hvor hårdt rummet bliver brugt.</p>
        <p>Og vi gør det digitalt: hvert stykke inventar tegnes og renderes i 3D, før vi skærer den første plade. I godkender det, I faktisk får.</p>
      </article>
      <article>
        <span class="n">II.</span>
        <h3>Både hele byggerier og den enkelte bænk</h3>
        <p>Vi leverer til større byggerier — skoler, daginstitutioner, idrætshaller og erhverv — med tilbudslister, materialegodkendelser og delleverancer, der følger byggepladsens tidsplan. Og vi laver også den enkelte bænk.</p>
        <p>Vi taler arkitekters og entreprenørers sprog, og vi ser os selv som den del af projektet, der gør de andres arbejde nemmere.</p>
      </article>
      <article>
        <span class="n">III.</span>
        <h3>Dokumentationen følger med</h3>
        <p>Bygger I efter Svanemærket, DGNB eller andre ordninger, leverer vi dokumentationen på de materialer, vi bruger: produktdatablade, indeklimadokumentation og EPD'er, hvor producenten har dem.</p>
        <p>Kræver udbuddet FSC- eller PEFC-træ, skriver vi i tilbuddet, hvilke plader der kan leveres med certificering fra leverandøren.</p>
      </article>
    </div>
  </div></section>

  <!-- ============ HOLDET ============ -->
  <section class="sec" id="holdet" style="padding-top:0"><div class="wrap">
    <div class="sec-head rv">
      <div>
        <span class="label">Holdet</span>
        <h2>Menneskene <em>bag.</em></h2>
        <p class="lede">Dem, I kommer til at tale med hele vejen gennem sagen. Vi tegner, sælger og følger produktionen — selve møblerne bygges i vores egenproduktion.</p>
      </div>
    </div>
    <div class="team2 rv">
      {TEAM.map((m) => (
        <article class="member2">
          <div class="m-photo"><img src={`${base}team/${m.img}`} alt={m.name} loading="lazy" /></div>
          <div class="body">
            <h3>{m.name}</h3>
            <p class="m-role">{m.role}</p>
            <p class="m-desc">{m.desc}</p>
            <p class="m-edu">{m.edu}</p>
            <details class="m-more">
              <summary>Uddannelse og baggrund</summary>
              <p>{m.bio}</p>
            </details>
            <p class="m-contact">
              <a href={`mailto:${m.email}`}>{m.email}</a><br />
              <a href={`tel:${m.phone.replace(/\s/g, '')}`}>{m.phone}</a>
            </p>
          </div>
        </article>
      ))}
    </div>
  </div></section>

  <!-- ============ PRODUKTIONEN ============ -->
  <section class="sec sec-dark" id="produktionen"><div class="wrap">
    <div class="sec-head rv">
      <div>
        <span class="label">Produktionen</span>
        <h2>Vores <em>egenproduktion.</em></h2>
      </div>
    </div>
    <div class="prod-text2 rv">
      <div class="prose">
        <p>Vi producerer inventaret i vores egen produktion. Opskæring, samling, overfladebehandling og pakning foregår hos os selv, så vi styrer kvaliteten og tidsplanen fra plade til færdigt emne.</p>
      </div>
      <div class="prose">
        <p>Produktionen arbejder ud fra den samme 3D-model og stykliste, som I har godkendt, og hvert produkt følges gennem produktionen med sin egen tjekliste. Olie og farvet olie påføres i produktionen, så inventaret kommer færdigbehandlet ud på pladsen.</p>
        <p>Vi følger op på arbejdsmiljøet og registrerer nærved-hændelser og ulykker, så vi kan rette årsagen og ikke kun symptomet.</p>
      </div>
    </div>
    <ProcessSteps />
  </div></section>

  <ContactCta />
</Base>
