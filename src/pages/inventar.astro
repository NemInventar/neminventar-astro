---
// /inventar (D4, spec §7): alle typer i kataloget med filtre pr. familie (fra v2's katalog). Varianterne vælges på
// hver typeside. Reglen (Fable 06-10-2026): et kort med billede er altid en type og fører altid til typesiden; noget at
// læse (landingssider) er piller og tekstlinks, aldrig et kort her. Typer uden arketype findes via "Det laver vi".
// Uden JS vises alle kort, og filtrene er skjulte.
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import ContactCta from '../components/ContactCta.astro';
import { getWebProducts } from '../lib/supabase';
import { cdn } from '../lib/img';
import { FAM, FAM_ORDER, famOf, productImage, fotoTag } from '../lib/catalog';

const products = await getWebProducts();
const base = import.meta.env.BASE_URL;
const site = Astro.site!;

type Card = { name: string; href: string; img: string; pos: string; foto: boolean; fam: string; desc: string };
const cards: Card[] = products.map((p) => {
  const im = productImage(p);
  return { name: p.name, href: `${base}produkter/${p.slug}`, img: im.img, pos: im.pos, foto: im.foto, fam: famOf(p), desc: p.intro ?? p.short_description ?? '' };
});
// Grupperet pr. familie. Inden for en familie: katalogets rækkefølge (web_display_order).
const all = cards.sort((a, b) => FAM_ORDER.indexOf(a.fam) - FAM_ORDER.indexOf(b.fam));
const famCount = (f: string) => all.filter((c) => c.fam === f).length;

const title = 'Fast inventar på mål: alle typer | Nem Inventar';
const description = 'Garderober, lockers, højskabe, bænke, tekøkkener, omklædning og vægge, bygget på mål til skoler, institutioner, idrætshaller og boliger. Se typerne og deres kulører.';
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: 'Fast inventar fra Nem Inventar',
    itemListElement: all.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, url: new URL(c.href, site).href })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Nem Inventar', item: new URL(base, site).href },
      { '@type': 'ListItem', position: 2, name: 'Inventar', item: new URL(base + 'inventar', site).href },
    ],
  },
];
const ogImage = all[0]?.img ? new URL(cdn(all[0].img, 1200), site).href : undefined;
---
<Base title={title} description={description} image={ogImage} jsonLd={jsonLd}>
  <section class="sec inv" id="katalog"><div class="wrap">
    <div class="sec-head">
      <div>
        <span class="label">Inventar</span>
        <h1 class="inv-h1">Fast inventar på mål. <em>Alle typer.</em></h1>
        <p class="lede">Typerne er gennemarbejdet fra samling til overflade og bygges på mål til jeres rum. Mangler I en type, tegner vi den.</p>
      </div>
      <a href={`${base}kontakt`} class="ulink">Mangler I noget særligt? →</a>
    </div>
    <div class="filters" id="filters" role="group" aria-label="Filtrér typer" hidden>
      <button type="button" class="fchip on" data-f="alle" aria-pressed="true">Alle<small>{all.length}</small></button>
      {FAM_ORDER.filter((f) => famCount(f) > 0).map((f) => <button type="button" class="fchip" data-f={f} aria-pressed="false">{FAM[f]}<small>{famCount(f)}</small></button>)}
    </div>
    <div class="types expanded" id="types">
      {all.map((c) => <ProductCard name={c.name} href={c.href} img={c.img} pos={c.pos} tag={fotoTag(c.foto)} fam={FAM[c.fam]} desc={c.desc} dataFam={c.fam} />)}
    </div>
  </div></section>

  <ContactCta />

  <style>
    .inv-h1{font-size:clamp(36px,4.6vw,64px);margin-top:22px;max-width:20ch}
    .filters[hidden]{display:none}
  </style>
  <script>
    // Filtre pr. familie (fra v2's katalog). Uden JS er filtrene skjulte, og alle kort vises.
    const types = document.getElementById('types');
    const bar = document.getElementById('filters');
    if (types && bar) {
      bar.hidden = false;
      const cards = Array.from(types.querySelectorAll<HTMLElement>('.tcard'));
      const chips = Array.from(bar.querySelectorAll<HTMLButtonElement>('.fchip'));
      const vis = (f: string) => {
        cards.forEach((t) => { t.hidden = !(f === 'alle' || t.dataset.fam === f); });
        chips.forEach((c) => { const on = c.dataset.f === f; c.classList.toggle('on', on); c.setAttribute('aria-pressed', String(on)); });
      };
      chips.forEach((c) => c.addEventListener('click', () => vis(c.dataset.f || 'alle')));
    }
  </script>
</Base>
