---
// Landingssider pr. emne (materiale/produkt), målgruppe og guide — /kompaktlaminat, /inventar-til-skoler, /krydsfiner-mdf-eller-spaanplade …
// Indhold: v_web_landing_pages (landing_web_2026_09_24). Statiske sider (om-os, kontakt …) vinder over denne rute.
// Guides læses som artikler (ét spor, stort billede, kort fortalt, tekst); emner og målgrupper har galleri + tekst side om side.
import Base from '../layouts/Base.astro';
import CallbackForm from '../components/CallbackForm.tsx';
import ProductCard from '../components/ProductCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ContactCta from '../components/ContactCta.astro';
import DesignerEksempler from '../components/DesignerEksempler.astro';
import Lockerberegner from '../components/Lockerberegner.astro';
import EKS from '../data/designer-eksempler.json';
import { DESIGNER_URL, eksempelLink } from '../lib/forside';
import FORREST from '../data/landing-forrest.json';
import { getWebLandingPages, getWebCases, getWebProducts, getWebColors, type WebLanding, type WebCase, type WebProduct, type WebColor, type WebImage } from '../lib/supabase';
import { cdn } from '../lib/img';
import { FAM, famOf, typeBillede, fotoTag, imgLabel } from '../lib/catalog';
import { translationsOf } from '../lib/guides-i18n';

export async function getStaticPaths() {
  const [pages, cases, products, colors] = await Promise.all([getWebLandingPages(), getWebCases(), getWebProducts(), getWebColors()]);
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page, pages, cases, products, colors } }));
}

interface Props { page: WebLanding; pages: WebLanding[]; cases: WebCase[]; products: WebProduct[]; colors: WebColor[] }
const { page, pages, cases, products, colors } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site!;
// Sider med en engelsk udgave (/en/, backlog e2c66652) får hreflang begge veje.
const EN_UDGAVE: Record<string, string> = { garderobeskab: 'en/wardrobes/', lockers: 'en/lockers/' };
// Guides med engelsk og tysk udgave (src/lib/guides-i18n.ts) får hreflang til dem.
const sprog = EN_UDGAVE[page.slug] ? [{ lang: 'en', path: EN_UDGAVE[page.slug] }] : translationsOf(page.slug, pages);
const alternates = sprog.length ? [
  { hreflang: 'da', href: new URL(`${base}${page.slug}/`, site).href },
  ...sprog.map((t) => ({ hreflang: t.lang, href: new URL(base + t.path, site).href })),
] : [];

const paragraphs = (page.body ?? '').split('\n\n').filter(Boolean);
// Links i brødtekst og FAQ-svar: [tekst](https://…) eller [tekst](/sti). Alt andet vises som ren tekst.
const LINK = /\[([^\]]+)\]\(((?:https?:\/\/|\/)[^)\s]+)\)/g;
const segs = (s: string) => {
  const out: { t: string; href?: string }[] = [];
  let last = 0;
  for (const m of s.matchAll(LINK)) {
    if (m.index! > last) out.push({ t: s.slice(last, m.index) });
    out.push({ t: m[1], href: m[2].startsWith('/') ? base + m[2].slice(1) : m[2] });
    last = m.index! + m[0].length;
  }
  if (last < s.length) out.push({ t: s.slice(last) });
  return out;
};
const plain = (s: string) => s.replace(LINK, '$1');
// Tabeller i brødtekst: et afsnit, hvor hver linje starter og slutter med |, bliver en tabel. Første linje er overskriften,
// og en linje med kun - og | springes over (markdown-formen). Til prisguiden (Joachim 19-10-2026): AI-motorerne citerer tal i tabeller.
const tabel = (s: string) => {
  const linjer = s.split('\n').map((l) => l.trim());
  if (linjer.length < 2 || !linjer.every((l) => l.length > 1 && l.startsWith('|') && l.endsWith('|'))) return null;
  const rk = linjer.filter((l) => !/^\|[\s:|-]+\|$/.test(l)).map((l) => l.slice(1, -1).split('|').map((c) => c.trim()));
  return { hoved: rk[0], rk: rk.slice(1) };
};
// Mellemoverskrifter i brødtekst: et afsnit, der starter med "## ", bliver en h2 (Joachim 20-10-2026: lange sider skal kunne
// deles op, så læseren og AI-motorerne kan finde afsnittet om fx materialer eller låger).
const overskrift = (s: string) => (s.startsWith('## ') ? plain(s.slice(3).trim()) : null);
// Billeder, der står forrest (src/data/landing-forrest.json): de samme, som annoncen viser, så klikket lander på det, man trykkede på.
const RENDER = 'https://guhbrpektblabndqttgp.supabase.co/storage/v1/object/public/quote-renders/42adeb65-7bc0-46eb-96f3-29d8bdbaef3f/9bbf66ed-64d6-475c-836b-27881626198f_';
const forrest: WebImage[] = (((FORREST as unknown as Record<string, { id: string; alt: string; caption: string }[]>)[page.slug]) ?? [])
  .map((f) => ({ src: `${RENDER}${f.id}.jpg`, alt: f.alt, caption: f.caption, kind: 'visualisering' }) as WebImage);
const images = [...forrest, ...(page.images ?? []).filter((im) => im.kind !== 'video')];
// Brødteksten deles ved mellemoverskrifterne: indledningen står åben, hvert afsnit foldes ud ved klik (teksten står stadig i HTML'en).
const blokke: { h: string | null; afsnit: string[] }[] = [{ h: null, afsnit: [] }];
for (const para of (page.body ?? '').split('\n\n').filter(Boolean)) {
  if (para.startsWith('## ')) blokke.push({ h: para.slice(3).trim().replace(/\[([^\]]+)\]\([^)]+\)/g, '$1'), afsnit: [] });
  else blokke[blokke.length - 1].afsnit.push(para);
}
const videos = (page.images ?? []).filter((im) => im.kind === 'video');
const hero = images[0];
const isGuide = page.kind === 'guide';
const isSegment = page.kind === 'segment';
// Bevar rækkefølgen fra tabellen — den er redaktionel.
const pick = <T extends { slug: string }>(all: T[], slugs: string[]) =>
  slugs.map((s) => all.find((x) => x.slug === s)).filter((x): x is T => Boolean(x));
const relCases = pick(cases, page.case_slugs ?? []);
const relProducts = pick(products, page.product_slugs ?? []);
const related = pick(pages, page.related_slugs ?? []);
const kontaktHref = `${base}kontakt?emne=${encodeURIComponent(page.nav_label)}`;
// Eksempler fra designeren (landing_web.designer_eksempler): det første er hovedknappen øverst, alle vises som kort under teksten.
const eks = DESIGNER_URL ? (page.designer_eksempler ?? []).filter((id) => EKS.some((e) => e.id === id)) : [];
const eks0 = EKS.find((e) => e.id === eks[0]);
// Et billede fra designeren kan åbnes i designeren ("Byg videre på denne"): images[].eks, ellers et eksempelbillede
// fra /billeder/designer-eksempler/<id>.jpg. Knappen under hovedbilledet følger med, når man skifter billede.
const eksAf = (im?: { src: string; eks?: string | null }) => {
  const id = im ? im.eks ?? im.src.match(/\/billeder\/designer-eksempler\/([a-z0-9-]+)\.jpg$/)?.[1] : undefined;
  const e = DESIGNER_URL && id ? EKS.find((x) => x.id === id) : undefined;
  return e ? { id: e.id, produkt: e.produkt, href: eksempelLink(e) } : null;
};
const heroEks = eksAf(hero);
const galleriEks = images.some((im) => eksAf(im));
// 3 kort pr. række, undtagen ved præcis 4 (så 2 × 2, ellers står ét kort alene nederst)
const caseCols = relCases.length === 4 ? 2 : relCases.length >= 3 ? 3 : 2;

const url = new URL(base + page.slug, site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Nem Inventar', item: new URL(base, site).href },
      { '@type': 'ListItem', position: 2, name: page.nav_label, item: url },
    ],
  },
  // Guides er forklarende artikler; de øvrige sider beskriver en ydelse.
  isGuide
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: page.h1,
        description: page.seo_description,
        author: { '@id': new URL(base, site).href + '#virksomhed' },
        publisher: { '@id': new URL(base, site).href + '#virksomhed' },
        dateModified: page.updated_at,
        inLanguage: 'da',
        ...(hero ? { image: cdn(hero.src, 1200) } : {}),
        mainEntityOfPage: url,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Service',
        name: page.h1,
        serviceType: page.nav_label,
        description: page.seo_description,
        provider: { '@id': new URL(base, site).href + '#virksomhed' },
        areaServed: { '@type': 'Country', name: 'Danmark' },
        url,
      },
  ...(page.faq?.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })),
      }]
    : []),
];
---
<Base title={page.seo_title} description={page.seo_description} image={hero ? cdn(hero.src, 1200) : undefined} jsonLd={jsonLd} alternates={alternates}>
  {isGuide ? (
    <!-- ============ GUIDE: artikel ============ -->
    <section class="guide"><div class="wrap">
      <div class="crumbrow"><a href={`${base}#ydelser`} class="crumb">← Alt vi laver</a></div>
      <div class="guide-head">
        {page.kicker && <span class="label">{page.kicker}</span>}
        <h1>{page.h1}</h1>
        {page.lead && <p class="lead">{page.lead}</p>}
      </div>
      {hero && (
        <figure class="guide-hero">
          <img class={hero.kind === 'tegning' ? 'contain' : undefined} src={cdn(hero.src, 1600)} alt={hero.alt} fetchpriority="high" />
          <figcaption class="img-tag"><b>{imgLabel(hero.kind)}</b>{hero.caption}</figcaption>
        </figure>
      )}
      {page.highlights?.length > 0 && (
        <dl class="lp-facts three rv">
          {page.highlights.map((h) => (<div><dt>{h.k}</dt><dd>{h.v}</dd></div>))}
        </dl>
      )}
      <div class="guide-aside">
        <div class="prose lp-prose rv">
          {paragraphs.map((para) => {
            const h = overskrift(para);
            if (h) return <h2 class="lp-h2">{h}</h2>;
            const t = tabel(para);
            return t ? (
              <div class="lp-tabel"><table>
                <thead><tr>{t.hoved.map((c) => <th>{c}</th>)}</tr></thead>
                <tbody>{t.rk.map((r) => <tr>{r.map((c) => <td>{segs(c).map((g) => (g.href ? <a href={g.href}>{g.t}</a> : g.t))}</td>)}</tr>)}</tbody>
              </table></div>
            ) : <p>{segs(para).map((g) => (g.href ? <a href={g.href}>{g.t}</a> : g.t))}</p>;
          })}
        </div>
        <aside class="guide-cta rv">
          <h3>Står I med et konkret rum?</h3>
          <p>Send tegninger eller mål, så vælger vi materialet sammen med jer og vender tilbage med pris.</p>
          <div class="detail-cta" style="flex-direction:column;align-items:stretch">
            <a href={kontaktHref} class="btn btn-primary" style="justify-content:center">Send tegninger eller mål <span class="arr">→</span></a>
            <a href="tel:+4542422684" class="btn btn-ghost" style="justify-content:center">+45 42 42 26 84</a>
            <CallbackForm client:load />
          </div>
        </aside>
      </div>
      {images.length > 1 && (
        <div class="cd-gallery rv" style="margin-top:48px">
          {images.slice(1).map((im) => (
            <figure class={`gfig${im.kind === 'tegning' ? ' contain' : ''}`} style="cursor:default">
              <img src={cdn(im.src, 800)} alt={im.alt} loading="lazy" decoding="async" />
              <figcaption class="img-tag"><b>{imgLabel(im.kind)}</b>{im.caption}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </div></section>
  ) : (
    <!-- ============ EMNE / MÅLGRUPPE: galleri + tekst ============ -->
    <section class="detail pd"><div class="wrap">
      <div class="crumbrow"><a href={`${base}#ydelser`} class="crumb">← Alt vi laver</a></div>
      <div class="pd-grid">
        <div class="gallery">
          {hero && (
            <figure class="pd-main lp-fig">
              <img id="main-img" class={hero.kind === 'tegning' ? 'contain' : undefined} src={cdn(hero.src, 1200)} alt={hero.alt} fetchpriority="high" />
              <span class="ptag" id="main-tag">{imgLabel(hero.kind)}</span>
              <figcaption id="main-cap" class="img-tag">{hero.caption}</figcaption>
            </figure>
          )}
          {heroEks && (
            <a class="btn btn-ghost lp-eks" href={heroEks.href} data-geks={heroEks.id} data-produkt={heroEks.produkt} data-side={page.slug}>Byg videre på denne i designeren <span class="arr">→</span></a>
          )}
        </div>
        <div class="detail-body">
          {page.kicker && <span class="kicker">{page.kicker}</span>}
          <h1>{page.h1}</h1>
          {page.lead && <p class="lead">{page.lead}</p>}
          <div class="detail-cta">
            {eks0 && <a href={eksempelLink(eks0)} class="btn btn-primary" data-eks={eks0.id} data-produkt={eks0.produkt} data-side={page.slug}>Byg den selv i designeren <span class="arr">→</span></a>}
            <a href={kontaktHref} class={`btn ${eks0 ? 'btn-ghost' : 'btn-primary'}`}>Send tegninger eller mål <span class="arr">→</span></a>
            <a href="tel:+4542422684" class="btn btn-ghost">+45 42 42 26 84</a>
            <CallbackForm client:load />
          </div>
        </div>
      </div>

      {images.length > 1 && (
        <div class="cd-gallery lp-billeder rv">
          {images.slice(1).map((im) => { const ex = eksAf(im); return (
            <figure class={`gfig${im.kind === 'tegning' ? ' contain' : ''}`}>
              <img src={cdn(im.src, 800)} alt={im.alt} loading="lazy" decoding="async" />
              {ex && <a class="ptag lp-byg" href={ex.href} data-geks={ex.id} data-produkt={ex.produkt} data-side={page.slug}>Åbn i designeren →</a>}
              <figcaption class="img-tag"><b>{imgLabel(im.kind)}</b><span>{im.caption}</span></figcaption>
            </figure>
          ); })}
        </div>
      )}

      {page.highlights?.length > 0 && (
        <dl class="lp-facts three rv">
          {page.highlights.map((h) => (<div><dt>{h.k}</dt><dd>{h.v}</dd></div>))}
        </dl>
      )}

      {videos.length > 0 && (
        <div class="lp-videos rv">
          {videos.map((v) => (
            <figure class="lp-video">
              <video data-src={cdn(v.src)} poster={v.poster ? cdn(v.poster) : undefined} muted loop playsinline preload="none" aria-label={v.alt}></video>
              {v.caption && <figcaption><b>Video</b>{v.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}
    </div></section>
  )}

  {(page.slug === 'lockers' || page.slug === 'hvad-koster-lockers') && <Lockerberegner />}

  {eks.length > 0 && (
    <section class="sec" id="designer"><div class="wrap">
      <div class="sec-head rv">
        <div>
          <span class="label">Design det selv</span>
          <h2>Byg den selv i <em>designeren.</em></h2>
          <p class="lede">Start fra et eksempel, og ret mål, materiale og indretning. Send det til os, så får du tilbud og tegning på dine mål.</p>
        </div>
        <a href={`${base}design-det-selv`} class="ulink">Alle eksempler →</a>
      </div>
      <DesignerEksempler ids={eks} side={page.slug} overskrift="h3" />
    </div></section>
  )}

  {!isGuide && paragraphs.length > 0 && (
    <section class="sec lp-tekst"><div class="wrap">
      <div class="prose lp-prose">
        {(() => {
          const afsnit = (para: string) => {
            const t = tabel(para);
            return t ? (
              <div class="lp-tabel"><table>
                <thead><tr>{t.hoved.map((c) => <th>{c}</th>)}</tr></thead>
                <tbody>{t.rk.map((r) => <tr>{r.map((c) => <td>{segs(c).map((g) => (g.href ? <a href={g.href}>{g.t}</a> : g.t))}</td>)}</tr>)}</tbody>
              </table></div>
            ) : <p>{segs(para).map((g) => (g.href ? <a href={g.href}>{g.t}</a> : g.t))}</p>;
          };
          return blokke.map((b) => b.h
            ? <details class="lp-sek"><summary><h2 class="lp-h2">{b.h}</h2></summary>{b.afsnit.map(afsnit)}</details>
            : b.afsnit.map(afsnit));
        })()}
      </div>
    </div></section>
  )}

  {relCases.length > 0 && (
    <section class="sec" id="projekter"><div class="wrap">
      <div class="sec-head rv">
        <div>
          <span class="label">Fra vores projekter</span>
          <h2>Det har vi <em>bygget.</em></h2>
          <p class="lede">Sager, hvor inventaret er tegnet til rummet, bygget i vores egenproduktion og leveret efter byggepladsens tidsplan.</p>
        </div>
        <a href={`${base}projekter`} class="ulink">Alle projekter →</a>
      </div>
      <div class={`pgrid rv${caseCols === 3 ? ' three' : ''}`}>
        {relCases.map((c) => <ProjectCard c={c} compact={caseCols === 3} />)}
      </div>
    </div></section>
  )}

  {relProducts.length > 0 && (
    <section class="sec inv" id="katalog"><div class="wrap">
      <div class="sec-head rv">
        <div>
          <span class="label">Inventar</span>
          <h2>Typer fra <em>kataloget.</em></h2>
          <p class="lede">Konstruktionen er løst. Målene er jeres: I vælger mål, materiale og farve, og vi tegner det i 3D, før vi bygger.</p>
        </div>
        <a href={`${base}inventar`} class="ulink">Hele kataloget →</a>
      </div>
      <div class="types all rv">
        {relProducts.map((p) => { const im = typeBillede(p, colors); return (
          <ProductCard name={p.name} href={`${base}produkter/${p.slug}`} img={im.img} pos={im.pos} tag={fotoTag(im.foto)} fam={FAM[famOf(p)]} desc={p.intro ?? p.short_description ?? ''} />
        ); })}
      </div>
    </div></section>
  )}

  {isSegment && (
    <section class="sec" id="saadan"><div class="wrap">
      <div class="sec-head rv">
        <div>
          <span class="label">Sådan arbejder vi</span>
          <h2>Fra 3D-model til <em>færdigt rum.</em></h2>
          <p class="lede">Holdet er ingeniører. Hvert skab, hver bænk og hver niche bygges først som 3D-model; samme model giver tegningen til jeres godkendelse og styklisten til produktionen.</p>
        </div>
        {pages.some((p) => p.slug === 'vaerkstedstegninger-og-3d-model') && <a href={`${base}vaerkstedstegninger-og-3d-model`} class="ulink">Sådan ser tegningerne ud →</a>}
      </div>
      <ProcessSteps />
    </div></section>
  )}

  {page.faq?.length > 0 && (
    <section class="sec lp-faq" style={isSegment || relProducts.length ? 'padding-top:0' : undefined}><div class="wrap">
      <span class="label">Spørgsmål og svar</span>
      <h2>Det bliver vi ofte <em>spurgt om.</em></h2>
      <div class="faq-list rv">
        {page.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{segs(f.a).map((g) => (g.href ? <a href={g.href}>{g.t}</a> : g.t))}</p>
          </details>
        ))}
      </div>
    </div></section>
  )}

  {related.length > 0 && (
    <section class="lp-related"><div class="wrap">
      <div class="yd-row rv"><span class="lbl">Se også:</span>{related.map((r) => <a class="pill" href={`${base}${r.slug}`}>{r.nav_label}</a>)}</div>
    </div></section>
  )}

  <ContactCta subject={page.nav_label} />

  <script>
    // Billeder fra designeren ("Byg videre på denne", "Åbn i designeren") tælles som "Eksempel valgt" (kilde galleri), ligesom kortene længere nede.
    document.querySelectorAll<HTMLAnchorElement>('a[data-geks]').forEach((a) => a.addEventListener('click', () => {
      (window as unknown as { plausible?: (n: string, o: object) => void }).plausible?.('Eksempel valgt', { props: { eksempel: a.dataset.geks ?? '', produkt: a.dataset.produkt ?? '', side: a.dataset.side ?? '', kilde: 'galleri' } });
    }));

    // Videoerne hentes først, når de kommer i syne, og afspilles uden lyd i løkke.
    const vids = document.querySelectorAll<HTMLVideoElement>('video[data-src]');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) {
          if (!v.src && v.dataset.src) v.src = v.dataset.src;
          v.play().catch(() => {});
        } else if (v.src) v.pause();
      });
    }, { rootMargin: '200px' });
    vids.forEach((v) => io.observe(v));
  </script>
  <style>
    .lp-eks{margin-top:12px}
    .pd-main{aspect-ratio:16/10}
    .detail-body .detail-cta{margin-top:28px}
    .lp-billeder{margin-top:28px}
    .lp-billeder .gfig{cursor:default}
    @media(max-width:680px){.lp-billeder .img-tag span{display:none}.lp-billeder .img-tag b{margin-right:0}.lp-byg{display:none}}
    .lp-byg{left:auto;right:12px;color:var(--ink);pointer-events:auto}
    .lp-facts.three{margin-top:28px}
    .lp-tekst{padding-top:0}
    .lp-tekst .lp-prose{margin-top:0;max-width:860px}
    .lp-sek{border-top:1px solid var(--line);padding:18px 0}
    .lp-sek:last-child{border-bottom:1px solid var(--line)}
    .lp-sek summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:20px}
    .lp-sek summary::-webkit-details-marker{display:none}
    .lp-sek summary::after{content:"+";color:var(--warm);font-size:24px;line-height:1;flex:none}
    .lp-sek[open] summary::after{content:"–"}
    .lp-sek summary .lp-h2{margin:0;font-size:clamp(19px,1.8vw,23px)}
    .lp-sek[open] summary{margin-bottom:14px}
  </style>
</Base>
