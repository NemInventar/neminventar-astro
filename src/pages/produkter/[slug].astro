---
// Produktside (arketype). Indhold fra v_web_products. Varianter (D4) fra images_meta: én vælger under hovedbilledet
// med typen i hver kulør, og "Få pris på denne" følger den valgte (Joachim 05-10-2026: "Hvorfor kører vi med 2?").
// Fotoet fra leverancen (lib/catalog PHOTO) er ikke en variant og står for sig som et rigtigt eksempel.
// Projekter og landingssider, der nævner typen, vises nedenunder.
import Base from '../../layouts/Base.astro';
import CallbackForm from '../../components/CallbackForm.tsx';
import ProductCard from '../../components/ProductCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ContactCta from '../../components/ContactCta.astro';
import { getWebProducts, getWebColors, getWebCases, getWebLandingPages, type WebProduct, type WebCase, type WebLanding, type WebColor } from '../../lib/supabase';
import { cdn } from '../../lib/img';
import { chipLabels } from '../../lib/labels';
import { FAM, famOf, productImage, typeBillede, fotoTag } from '../../lib/catalog';
import { DESIGNER_AF, designerLink } from '../../lib/forside';
import { varianterAf, prisHref } from '../../lib/varianter';

export async function getStaticPaths() {
  const [products, cases, landing, colors] = await Promise.all([getWebProducts(), getWebCases(), getWebLandingPages(), getWebColors()]);
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p, products, cases, landing, colors } }));
}

interface Props { product: WebProduct; products: WebProduct[]; cases: WebCase[]; landing: WebLanding[]; colors: WebColor[] }
const { product, products, cases, landing, colors } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site!;
const materials = chipLabels(product.materials);
const finishes = chipLabels(product.finishes);
const applications = chipLabels(product.applications);
const paragraphs = (product.story ?? product.short_description ?? '').split('\n\n').filter(Boolean);
const fam = famOf(product);

// Varianter: typen i hver kulør, vi har en render af. Hovedbilledet starter på den første.
// Uden varianter (bør ikke ske) vises typens billede som før.
const varianter = varianterAf(product, colors);
const v0 = varianter[0] ?? null;
const pi = productImage(product);
const mainImg = v0?.img ?? pi.img;
const altAf = (label?: string) => (label ? `${product.name} i ${label.toLowerCase()}` : product.name);
// Fotoet fra leverancen: et rigtigt eksempel, ikke et valg.
const foto = pi.foto ? pi.img : null;
const designerProdukt = DESIGNER_AF[product.slug];
// Designeren og IFC-filen åbner i den valgte kulør (lib/forside designerLink); null for typer uden model i designeren.
const dLink = (k?: string) => designerLink(product.slug, k) ?? undefined;
const ifcLink = (k?: string) => designerLink(product.slug, k, 'ifc') ?? undefined;

// Landingssider, der nævner typen, og projekterne de peger på (data, ikke gæt)
const relLanding = landing.filter((l) => (l.product_slugs ?? []).includes(product.slug));
const caseSlugs = [...new Set(relLanding.flatMap((l) => l.case_slugs ?? []))];
const relCases = caseSlugs.map((s) => cases.find((c) => c.slug === s)).filter((c): c is WebCase => !!c).slice(0, 3);
// Andre typer: samme familie først, derefter resten
const others = [...products.filter((p) => p.slug !== product.slug && famOf(p) === fam), ...products.filter((p) => p.slug !== product.slug && famOf(p) !== fam)].slice(0, 3);

// Andre farver (Joachim 06-10-2026: "Kan man få andre farver??? Og så sige ja selvfølgelig."). Gælder alle typer.
const FARVE_FAQ = {
  q: 'Kan man få andre farver?',
  a: 'Ja, selvfølgelig. Her viser vi de farver, vi har på lager. Olien, laminatet og stoffet findes i mange flere farver, og ud fra en prøve eller en RAL- eller NCS-kode finder vi den, der ligger tættest på. Skriv farven i forespørgslen.',
};
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Nem Inventar', item: new URL(base, site).href },
    { '@type': 'ListItem', position: 2, name: 'Inventar', item: new URL(base + 'inventar', site).href },
    { '@type': 'ListItem', position: 3, name: product.name, item: new URL(`${base}produkter/${product.slug}`, site).href },
  ],
}, {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{ '@type': 'Question', name: FARVE_FAQ.q, acceptedAnswer: { '@type': 'Answer', text: FARVE_FAQ.a } }],
}];
---
<Base title={product.seo_title} description={product.seo_description} image={mainImg ? cdn(mainImg, 1200) : undefined} jsonLd={jsonLd}>
  <section class="pd"><div class="wrap">
    <div class="crumbrow"><a href={`${base}inventar`} class="crumb">← Kataloget</a></div>
    <div class="pd-grid">
      <div class="gallery" id="galleri">
        {mainImg && (
          <figure class="pd-main">
            <img id="main-img" src={cdn(mainImg, 1200)} alt={altAf(v0?.label)} style={v0 ? undefined : `--pos:${pi.pos}`} fetchpriority="high" />
            <span class="ptag">{v0 ? fotoTag(false) : fotoTag(pi.foto)}</span>
          </figure>
        )}
        {varianter.length > 1 && (
          <div class="vtiles" role="group" aria-label="Vælg kulør">
            {varianter.map((v, i) => (
              <a class={`vtile${i === 0 ? ' active' : ''}`} href={`#${v.id}`} data-v={v.id} data-src={cdn(v.img, 1200)}
                 data-alt={altAf(v.label)} data-label={v.label} data-pris={prisHref(base, v)} data-designer={dLink(v.kuloer)} data-ifc={ifcLink(v.kuloer)}
                 aria-current={i === 0 ? 'true' : undefined}>
                <img src={cdn(v.img, 480)} alt={altAf(v.label)} loading="lazy" decoding="async" />
                <span>{v.hex && <i style={`background:${v.hex}`}></i>}{v.label}</span>
              </a>
            ))}
          </div>
        )}
        {foto && (
          <figure class="pd-foto">
            <img src={cdn(foto, 1000)} alt={`${product.name}, foto fra en leverance`} style={`--pos:${pi.pos}`} loading="lazy" decoding="async" />
            <figcaption>Fra en leverance: sådan ser typen ud i et rigtigt rum.</figcaption>
          </figure>
        )}
      </div>
      <div class="detail-body">
        <span class="kicker">{FAM[fam]}</span>
        <h1>{product.name}</h1>
        {product.hero_tagline && <p class="lead">{product.hero_tagline}</p>}
        <div class="prose">
          {paragraphs.map((para) => <p>{para}</p>)}
        </div>
        <div class="pd-spec">
          {materials.length > 0 && <div class="row"><span class="k">Materialer</span><div class="chips">{materials.map((m) => <span>{m}</span>)}</div></div>}
          {finishes.length > 0 && <div class="row"><span class="k">Overflade</span><div class="chips">{finishes.map((f) => <span>{f}</span>)}</div></div>}
          {applications.length > 0 && <div class="row"><span class="k">Velegnet til</span><div class="chips">{applications.map((a) => <span>{a}</span>)}</div></div>}
        </div>
        <details class="pd-faq"><summary>{FARVE_FAQ.q}</summary><p>{FARVE_FAQ.a}</p></details>
        <p class="pd-made"><b>Til mål</b> · pris efter opmåling · tegnet i 3D til godkendelse, før vi bygger</p>
        <div class="detail-cta">
          <a id="pris-knap" href={prisHref(base, v0 ?? { slug: product.slug, navn: product.name })} class="btn btn-primary">Få pris på denne<span id="pris-label">{v0 && varianter.length > 1 ? ` · ${v0.label}` : ''}</span> <span class="arr">→</span></a>
          <a href="tel:+4542422684" class="btn btn-ghost">+45 42 42 26 84</a>
          <CallbackForm client:load />
        </div>
        {designerProdukt && dLink(v0?.kuloer) && (
          <p class="pd-designer"><span>Byg {designerProdukt === 'locker' ? 'lockerne' : 'skabene'} selv i 3D: mål, kulør og antal. Arkitekter kan hente modellen som IFC til Revit og ArchiCAD.</span>
            <span class="pd-dlinks"><a id="designer-knap" href={dLink(v0?.kuloer)}>Åbn designeren →</a><a id="ifc-knap" href={ifcLink(v0?.kuloer)}>Hent IFC →</a></span></p>
        )}
      </div>
    </div>
  </div></section>

  {relCases.length > 0 && (
    <section class="sec" id="projekter"><div class="wrap">
      <div class="sec-head rv">
        <div>
          <span class="label">Fra vores projekter</span>
          <h2>Sager med inventar i samme <em>familie.</em></h2>
          <p class="lede">Projekter, hvor vi har bygget {FAM[fam].toLowerCase()} — tegnet til rummet, bygget i vores egenproduktion og monteret af os.</p>
        </div>
        <a href={`${base}projekter`} class="ulink">Alle projekter →</a>
      </div>
      <div class={`pgrid rv${relCases.length > 2 ? ' three' : ''}`}>
        {relCases.map((c) => <ProjectCard c={c} compact={relCases.length > 2} />)}
      </div>
    </div></section>
  )}

  {others.length > 0 && (
    <section class="sec inv" id="andre"><div class="wrap">
      <div class="sec-head rv">
        <div>
          <span class="label">Inventar</span>
          <h2>Andre typer i <em>kataloget.</em></h2>
          <p class="lede">Konstruktionen er løst. Målene er jeres: I vælger mål, materiale og farve, og vi tegner det i 3D, før vi bygger.</p>
        </div>
        <a href={`${base}inventar`} class="ulink">Hele kataloget →</a>
      </div>
      <div class="types all rv">
        {others.map((p) => { const im = typeBillede(p, colors); return (
          <ProductCard name={p.name} href={`${base}produkter/${p.slug}`} img={im.img} pos={im.pos} tag={fotoTag(im.foto)} fam={FAM[famOf(p)]} desc={p.intro ?? p.short_description ?? ''} />
        ); })}
      </div>
      {relLanding.length > 0 && (
        <div class="yd-row rv" style="margin-top:36px"><span class="lbl">Læs mere om:</span>{relLanding.map((l) => <a class="pill" href={`${base}${l.slug}`}>{l.nav_label}</a>)}</div>
      )}
    </div></section>
  )}

  <ContactCta subject={product.name} />

  <style>
    .vtiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:12px}
    .vtile{display:flex;flex-direction:column;gap:6px;border:1px solid var(--line);border-radius:12px;padding:6px;background:#fff;color:var(--muted);font-size:13.5px;font-weight:500;line-height:1.25;transition:border-color .2s}
    .vtile img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:8px}
    .vtile span{display:flex;align-items:center;gap:6px;padding:0 2px 2px}
    .vtile i{width:12px;height:12px;border-radius:50%;flex:none;border:1px solid rgba(23,20,14,.18)}
    .vtile:hover{border-color:var(--warm-soft)}
    .vtile.active{border-color:var(--warm);box-shadow:0 0 0 1px var(--warm);color:var(--ink)}
    .pd-dlinks{display:flex;flex-direction:column;gap:6px;flex:none}
    @media (max-width:600px){.pd-designer{flex-direction:column;align-items:flex-start}.pd-dlinks{flex-direction:row;gap:16px}}
    .pd-faq{margin-top:18px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:10px 0}
    .pd-faq summary{cursor:pointer;font-weight:600;font-size:15px}
    .pd-faq p{margin:8px 0 2px;font-size:14.5px;color:var(--muted);max-width:60ch}
    .pd-foto{margin:22px 0 0;border-top:1px solid var(--line);padding-top:18px}
    .pd-foto img{width:100%;aspect-ratio:16/9;object-fit:cover;object-position:var(--pos,50% 50%);border-radius:14px}
    .pd-foto figcaption{font-size:13.5px;color:var(--muted);margin-top:8px}
    @media (max-width:600px){.vtiles{grid-template-columns:1fr 1fr}}
  </style>
  <script>
    // Vælgeren: billedet, alt-teksten og "Få pris på denne" følger den valgte kulør. #v-<kulør> (fra forsiden) vælger.
    // Billederne bærer data-v, ikke id, så Base.astro's anker-rulning ikke trækker siden ned til vælgeren.
    const main = document.getElementById('main-img') as HTMLImageElement | null;
    const knap = document.getElementById('pris-knap') as HTMLAnchorElement | null;
    const label = document.getElementById('pris-label');
    const tiles = Array.from(document.querySelectorAll<HTMLAnchorElement>('.vtile'));
    const dKnap = document.getElementById('designer-knap') as HTMLAnchorElement | null;
    const ifcKnap = document.getElementById('ifc-knap') as HTMLAnchorElement | null;
    const vaelg = (t: HTMLAnchorElement) => {
      const { src, alt, label: l, pris, designer, ifc } = t.dataset;
      if (dKnap && designer) dKnap.href = designer;
      if (ifcKnap && ifc) ifcKnap.href = ifc;
      if (main && src) { main.style.opacity = '0'; main.onload = () => { main.style.opacity = '1'; }; main.src = src; if (alt) main.alt = alt; if (main.complete) main.style.opacity = '1'; }
      if (knap && pris) knap.href = pris;
      if (label) label.textContent = l ? ` · ${l}` : '';
      tiles.forEach((x) => { x.classList.toggle('active', x === t); if (x === t) x.setAttribute('aria-current', 'true'); else x.removeAttribute('aria-current'); });
    };
    tiles.forEach((t) => t.addEventListener('click', (e) => { e.preventDefault(); vaelg(t); history.replaceState(null, '', '#' + t.dataset.v); }));
    const fra = tiles.find((t) => '#' + t.dataset.v === location.hash);
    if (fra) vaelg(fra);
  </script>
</Base>
