---
// Forside v3 (05-10-2026): "Se det, før vi bygger det." Godkendt af Joachim ("forsiden er vild, det er præcis sådan
// det skal være"). Mockup: mockups/forside-v3.html · spec: docs/superpowers/specs/2026-10-05-ny-forside-design.md.
// Syv afsnit med almindelig scroll: toppen med tre veje → bevisbjælke → inspiration → det laver vi → sådan arbejder vi
// → projekter → kulører → kontakt. Indhold fra Supabase-views; kun udvalg og rækkefølge står i src/lib/forside.ts.
// En sag nævnes sparsomt (opmærksomhedspunkt, Joachim 05-10): fotos får en billedtekst om, hvad de viser.
import Base from '../layouts/Base.astro';
import HeroPaths from '../components/HeroPaths.astro';
import ProofRow from '../components/ProofRow.astro';
import InspirationMosaic from '../components/InspirationMosaic.astro';
import KulorBand from '../components/KulorBand.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getWebProducts, getWebCases, getWebLandingPages, getWebColors } from '../lib/supabase';
import { cdn } from '../lib/img';
import { morkhoj } from '../lib/catalog';
import { KATALOG_TOP, PROJEKTER, emneGruppe } from '../lib/forside';
import { TEAM } from '../lib/team';
import { PHONE, PHONE_TEL } from '../lib/contact';

const products = await getWebProducts();
const cases = await getWebCases();
const landing = await getWebLandingPages();
const colors = await getWebColors();
const base = import.meta.env.BASE_URL;
const site = Astro.site!;
const segmenter = landing.filter((l) => l.kind === 'segment');
const emner = landing.filter((l) => l.kind === 'emne');
const guides = landing.filter((l) => l.kind === 'guide');
const emneRaekker = [
  { lbl: 'Inventar', sider: emner.filter((l) => emneGruppe(l.slug) === 'inventar') },
  { lbl: 'Materialer', sider: emner.filter((l) => emneGruppe(l.slug) === 'materialer') },
];
const arbejdsform = emner.filter((l) => emneGruppe(l.slug) === 'arbejdsform');
const hasLanding = (slug: string) => landing.some((l) => l.slug === slug);
const projekter = PROJEKTER.map((s) => cases.find((c) => c.slug === s)).filter((c): c is NonNullable<typeof c> => !!c);
const typer = [...products].sort((a, b) => a.name.localeCompare(b.name, 'da'));

const title = 'Fast inventar på mål til byggeri | Nem Inventar';
const description = 'Fast inventar på mål til skoler, institutioner, idrætshaller og boliger. Se det i 3D, send en skitse eller et udbud, og få svar inden for én arbejdsdag.';
const ogImage = new URL(cdn(morkhoj('33_lockere-roede-ved-doer-til-klasserum.jpg')), site).href;

// Katalogpanelets typer som ItemList (søgemaskiner og AI-assistenter kan læse, hvad vi bygger)
const itemList = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Fast inventar fra Nem Inventar',
  itemListElement: KATALOG_TOP.map((k, i) => products.find((p) => p.slug === k.slug)).filter((p) => !!p)
    .map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p!.name, url: new URL(`${base}produkter/${p!.slug}`, site).href })),
};
---
<Base title={title} description={description} image={ogImage} jsonLd={[itemList]} alternates={[
  { hreflang: 'da', href: new URL(base, site).href },
  { hreflang: 'en', href: new URL(base + 'en/', site).href },
  { hreflang: 'x-default', href: new URL(base, site).href },
]}>

  <!-- 1 · TOPPEN: tre veje -->
  <HeroPaths products={products} colors={colors} />

  <!-- 2 · BEVIS: fire tal fra fire sager -->
  <ProofRow cases={cases} />

  <!-- 3 · INSPIRATION -->
  <section class="sec" id="inventar"><div class="wrap">
    <div class="sec-head rv">
      <div>
        <span class="label">Inspiration</span>
        <h2>Set i 3D, før det <em>bygges.</em></h2>
        <p class="lede">Visualiseringer af typer, vi bygger. Hver udgave kan prissættes, som den står, eller bygges om til jeres mål og kulør.</p>
      </div>
      <a href="#katalog" class="ulink">Til kataloget i toppen ↑</a>
    </div>
    <div class="rv"><InspirationMosaic products={products} colors={colors} /></div>

    <!-- 3b · DET LAVER VI: link-hubben til typerne og landingssiderne (ankeret #ydelser bruges af alle landingssider).
         Én slags link pr. række: typer → typesider; resten er sider at læse (emneGruppe i lib/forside). -->
    <div class="yd-links rv" id="ydelser">
      <h2 class="label yd-h">Det laver vi</h2>
      <div class="yd-row"><span class="lbl">Typer:</span>{typer.map((p) => <a class="pill" href={`${base}produkter/${p.slug}`}>{p.name}</a>)}<a class="ulink yd-alle" href={`${base}inventar`}>Alle typer →</a></div>
      {emneRaekker.filter((r) => r.sider.length > 0).map((r) => <div class="yd-row"><span class="lbl">{r.lbl}:</span>{r.sider.map((l) => <a class="pill" href={`${base}${l.slug}`}>{l.nav_label}</a>)}</div>)}
      {segmenter.length > 0 && <div class="yd-row"><span class="lbl">Til:</span>{segmenter.map((l) => <a class="pill" href={`${base}${l.slug}`}>{l.nav_label}</a>)}</div>}
      {arbejdsform.length > 0 && <div class="yd-row"><span class="lbl">Sådan arbejder vi:</span>{arbejdsform.map((l) => <a class="pill" href={`${base}${l.slug}`}>{l.nav_label}</a>)}</div>}
      {guides.length > 0 && <div class="yd-row"><span class="lbl">Guides:</span>{guides.map((l) => <a class="pill" href={`${base}${l.slug}`}>{l.nav_label}</a>)}</div>}
    </div>
  </div></section>

  <!-- 4 · SÅDAN ARBEJDER VI -->
  <section class="sec" id="saadan" style="padding-top:0"><div class="wrap">
    <div class="sec-head rv">
      <div>
        <span class="label">Sådan arbejder vi</span>
        <h2>Fra 3D-model til <em>færdigt rum.</em></h2>
        <p class="lede">Holdet er ingeniører. Hvert skab, hver bænk og hver niche bygges først som 3D-model; samme model giver tegningen til jeres godkendelse og styklisten til produktionen.</p>
      </div>
      {hasLanding('vaerkstedstegninger-og-3d-model') && <a href={`${base}vaerkstedstegninger-og-3d-model`} class="ulink">Sådan ser tegningerne ud →</a>}
    </div>
    <ProcessSteps />
    <div class="docs rv">
      <b>Dokumentation og filer:</b>
      <span class="chip">Svanemærket byggeri</span><span class="chip">DGNB</span><span class="chip">EPD</span><span class="chip">IFC-modeller</span>
      <a class="chip" href="https://www.dalux.com/da/" target="_blank" rel="noopener">Dalux ↗</a>
      <a class="chip" href="https://ibinder.com/da/" target="_blank" rel="noopener">iBinder ↗</a>
    </div>
  </div></section>

  <!-- 5 · PROJEKTER (her nævnes sagerne ved navn) -->
  <section class="sec projekter-udvalg" id="projekter-udvalg"><div class="wrap">
    <div class="sec-head rv">
      <div>
        <span class="label">Projekter</span>
        <h2>Skoler, boliger og <em>idræt.</em></h2>
        <p class="lede">Et udvalg af de sager, vi har leveret eller har i produktion.</p>
      </div>
      <a href={`${base}projekter`} class="ulink">Alle projekter, arkitekter og entreprenører →</a>
    </div>
    <div class="pgrid three rv">{projekter.map((c) => <ProjectCard c={c} compact />)}</div>
  </div></section>

  <!-- 6 · KULØRER -->
  <section class="sec" id="kulorer"><div class="wrap">
    <div class="sec-head rv">
      <div>
        <span class="label">Overflade</span>
        <h2>Otte kulører — eller <em>jeres</em> egen.</h2>
        <p class="lede">Vi olierer med Rubio Monocoat. Bagved ligger et farvekort med omkring 40 kulører, og vi kan få blandet en til jer.</p>
      </div>
      {hasLanding('bejdset-olieret-eller-lakeret') && <a href={`${base}bejdset-olieret-eller-lakeret`} class="ulink">Bejdset, olieret eller lakeret? →</a>}
    </div>
    <div class="rv"><KulorBand colors={colors} /></div>
    <div class="surf rv">
      <div><b>Olie, ikke lak</b><span>Ét lag hårdvoksolie, der trænger ind i træet. Der er ingen lakfilm, der kan skalle af.</span></div>
      <div><b>Slid kan pletrepareres</b><span>En ridse slibes og olieres på stedet uden at skifte lågen.</span></div>
      <div><b>Samme kulør igen</b><span>Kuløren er en opskrift, så en ekstra låge om tre år får samme farve.</span></div>
    </div>
  </div></section>

  <!-- 7 · KONTAKT -->
  <section class="sec sec-dark" id="kontakt"><div class="wrap kontakt-grid">
    <div class="rv">
      <span class="label">Kontakt</span>
      <h2 class="kontakt-h">Send os tegningerne. <em>Eller en skitse.</em></h2>
      <p class="lede">Et udbud, en tegning eller et foto af rummet med mål er nok til en pris. Vi svarer inden for én arbejdsdag.</p>
      <div class="kontakt-btns">
        <a href="#send" class="btn btn-light">Send materialet <span class="arr">→</span></a>
        <a href="#design" class="btn btn-dark-ghost">Design det selv</a>
      </div>
      <div class="clines">
        <a href={`tel:${PHONE_TEL}`} class="tel">{PHONE}</a>
        <span><a href="mailto:tilbud@neminventar.dk">tilbud@neminventar.dk</a></span>
        <span>Nem Inventar ApS · Mågevej 73, st. tv. · 2400 København NV · CVR 45085473</span>
      </div>
    </div>
    <div class="team rv">
      {TEAM.map((m) => (
        <div class="mem">
          <img src={`${base}team/${m.img}`} alt={m.name} loading="lazy" decoding="async" />
          <div><b>{m.name}</b><span>{m.desc}</span><a href={`mailto:${m.email}`}>{m.email}</a></div>
        </div>
      ))}
    </div>
  </div></section>

  <style>
    .yd-links{margin-top:48px;padding-top:28px;border-top:1px solid var(--line)}
    .yd-h{margin-bottom:6px}
    .yd-alle{font-size:14px;margin-left:4px;white-space:nowrap}
    .docs{display:flex;gap:8px 10px;flex-wrap:wrap;align-items:center;margin-top:32px;padding-top:22px;border-top:1px solid var(--line);font-size:14px;color:var(--muted)}
    .docs b{color:var(--ink);font-weight:600;margin-right:6px}
    .docs .chip{border:1px solid var(--line);background:#fff;border-radius:999px;padding:5px 12px;font-size:13px;color:var(--ink);text-decoration:none}
    .projekter-udvalg{background:var(--soft);border-block:1px solid var(--line)}
    .surf{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px 28px;margin-top:28px}
    .surf div{border-top:1px solid var(--line);padding-top:12px}
    .surf b{font-family:'Archivo',sans-serif;font-size:17px;display:block}
    .surf span{font-size:14.5px;color:var(--muted)}
    .kontakt-grid{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:clamp(28px,5vw,72px);align-items:start}
    .kontakt-h{font-size:clamp(32px,4.2vw,56px);line-height:1;letter-spacing:-.03em;margin-top:22px}
    .kontakt-btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
    .team{display:grid;gap:12px}
    .mem{display:grid;grid-template-columns:64px 1fr;gap:14px;align-items:center;border:1px solid var(--dark-line);border-radius:16px;padding:12px;background:var(--dark-2)}
    .mem img{width:64px;height:64px;border-radius:12px;object-fit:cover;background:#3a3226}
    .mem b{display:block;font-family:'Archivo',sans-serif;font-size:16px;color:#F4EFE6}
    .mem span{display:block;font-size:13.5px;color:var(--dark-muted)}
    .mem a{font-size:13.5px;color:#F4EFE6;text-decoration-color:#5A4F3C;text-underline-offset:3px}
    @media (max-width:900px){.kontakt-grid{grid-template-columns:1fr}.surf{grid-template-columns:1fr}}
  </style>
</Base>
