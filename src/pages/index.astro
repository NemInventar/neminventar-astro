---
// Forside v2 (04-10-2026). Mockup og beslutninger: mockups/forside-v2.html + mockups/forside-v2-plan.md.
// Indholdet kommer fra Supabase-views (v_web_products, v_web_cases, v_web_landing_pages). I koden står kun
// rækkefølge, hvilke fotos der roterer i toppen, og fem typer der endnu ikke er arketyper (de peger på landingssider).
// Kortene, tal-striben, proces-trinnene og kontakt-afsnittet er fælles komponenter (bruges også på undersiderne).
import Base from '../layouts/Base.astro';
import DesignerTeaser from '../components/DesignerTeaser.astro';
import ProductCard from '../components/ProductCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ContactCta from '../components/ContactCta.astro';
import Ticker from '../components/Ticker.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import { getWebProducts, getWebCases, getWebLandingPages, getWebColors } from '../lib/supabase';
import { cdn } from '../lib/img';
import { FAM, FAM_ORDER, famOf, productImage, fotoTag, isPhoto, morkhoj, photoProjectName, tal, PHOTO_PROJECT_SLUG } from '../lib/catalog';

const products = await getWebProducts();
const cases = await getWebCases();
const landing = await getWebLandingPages();
// Kulørstriben i overflade-afsnittet: vores standardkulører (alle Rubio Monocoat). To af dem sidder på Mørkhøj.
const colors = await getWebColors();
const MORKHOJ_COLORS = ['roedbrun', 'blaa'];
// Kulørbåndets rækkefølge: lys → mørk med Skovgrøn i midten (planen). Ukendte slugs lægges bagerst.
const BAND_ORDER = ['natur', 'roeget-eg', 'roedbrun', 'skovgroen', 'blaa', 'charcoal', 'sort'];
const bandColors = [...colors].sort((a, b) => ((BAND_ORDER.indexOf(a.slug) + 1) || 99) - ((BAND_ORDER.indexOf(b.slug) + 1) || 99));
const emner = landing.filter((l) => l.kind === 'emne');
const segmenter = landing.filter((l) => l.kind === 'segment');
const guides = landing.filter((l) => l.kind === 'guide');
const base = import.meta.env.BASE_URL; // slutter med '/'
const site = Astro.site!;

const title = 'Fast inventar på mål til byggeri | Nem Inventar';
const description =
  'Fast inventar på mål: garderober, lockers, højskabe, siddenicher og tekøkkener til skoler, institutioner og idrætshaller. Tegnet i 3D, bygget i egen produktion.';

// ---------- Fremhævet projekt (Mørkhøj) og de andre ----------
const featured = cases.find((c) => c.slug === PHOTO_PROJECT_SLUG) ?? cases[0];
const others = cases.filter((c) => c.slug !== featured?.slug);
const gallery = featured?.gallery ?? [];
const altFor = (file: string, fallback: string) => gallery.find((g) => g.src.endsWith('/' + file))?.alt ?? fallback;
const numbers = tal(featured);
// overskriftens tre tal: korte mærkater og forskellige tal
const headTal: { b: string; t: string }[] = [];
for (const x of numbers) { const t = x.t.replace(' og siddemøbler', ''); if (t.length <= 11 && !headTal.some((h) => h.b === x.b) && headTal.length < 3) headTal.push({ b: x.b, t }); }
const ONE: Record<string, string> = { 'morkhoj-skole': 'Én skole.' };
const one = ONE[featured?.slug ?? ''] ?? 'Ét byggeri.';
const projektNavn = photoProjectName(cases);

// Toppen: to felter, der skifter ét ad gangen. Bredt felt = liggende fotos, smalt = højformater.
// Venstre felt viser de BLÅ rum, højre de RØDE (Milot 04-10-2026): så står der aldrig to røde skabe ved siden
// af hinanden, og hvert skift veksler mellem blå og rød. Fotos med røde lockers i baggrunden hører derfor ikke til venstre.
// Flyttes til data (et hero-flag i case-galleriet), så fotos og tekster kan rettes i /tekster — se planen.
type HeroItem = { file: string; pos: string; room: string; what: string };
const HERO_L: HeroItem[] = [
  { file: '22_klasserum-hoejskabe-blaa-og-vindueskarm-med-hynde.jpg', pos: '55% 50%', room: 'Klasserummet', what: 'højskabe og siddeplads i vindueskarmen' },
  { file: '25_baenke-blaa-med-ryghynder-og-mellemvaeg.jpg', pos: '50% 55%', room: 'Fællesarealet', what: 'bænke med ryghynder' },
  { file: '31_tekoekken-blaa-fronter-og-lamper.jpg', pos: '50% 55%', room: 'Tekøkkenet', what: 'blå fronter, stålbordplade' },
  { file: '34_niche-med-ryghynde-og-stikkontakt.jpg', pos: '60% 50%', room: 'Nichen', what: 'ryghynde og indbygget stik' },
];
const HERO_R: HeroItem[] = [
  { file: '26_garderobe-lockere-roede-med-baenk-og-skohylder.jpg', pos: '50% 58%', room: 'Garderoben', what: '16 lockers over bænk og skohylder' },
  { file: '23_polstret-niche-roed-afrundet-hjoerne.jpg', pos: '65% 50%', room: 'Nichen', what: 'polstret, afrundet hjørne' },
  { file: '20_lockere-roede-perforerede-laager-kodelaase-og-skohylder.jpg', pos: '50% 50%', room: 'Lågerne', what: 'perforeret, med kodelås' },
  { file: '30_lockere-roede-i-hjoerne-med-skohylder.jpg', pos: '50% 50%', room: 'Garderoben', what: 'lockers i hjørnet' },
];
const heroData = (pool: HeroItem[]) => pool.map((h) => ({ src: cdn(morkhoj(h.file)), pos: h.pos, alt: altFor(h.file, `${h.room}: ${h.what}`), room: h.room, what: h.what }));
const heroL = heroData(HERO_L), heroR = heroData(HERO_R);

// Mosaik i den fremhævede sag: fotos, der ikke er i toppen
const MOSAIK = [
  { file: '25_baenke-blaa-med-ryghynder-og-mellemvaeg.jpg', pos: '50% 55%', cls: 'w', k: 'Fællesarealet', v: 'bænke med ryghynder' },
  { file: '23_polstret-niche-roed-afrundet-hjoerne.jpg', pos: '72% 50%', cls: 't', k: 'Nichen', v: 'polstret, afrundet hjørne' },
  { file: '28_niche-roed-polstret-med-bord.jpg', pos: '30% 40%', cls: 's', k: 'Gruppenichen', v: 'med bord og stik' },
  { file: '34_niche-med-ryghynde-og-stikkontakt.jpg', pos: '60% 50%', cls: 's', k: 'Detaljen', v: 'stikkontakt bygget ind' },
  { file: '37_baenk-med-hynde-i-sollys.jpg', pos: '50% 50%', cls: 's', k: 'Bænken', v: 'krydsfiner med hynde' },
];

// ---------- Inventar: alle arketyper + fem typer, der endnu ikke er arketyper ----------
type Card = { key: string; name: string; href: string; img: string; pos: string; foto: boolean; fam: string; desc: string };
const cards: Card[] = products.map((p) => {
  const im = productImage(p);
  return { key: p.slug, name: p.name, href: `${base}produkter/${p.slug}`, img: im.img, pos: im.pos, foto: im.foto, fam: famOf(p), desc: p.intro ?? p.short_description ?? '' };
});
// Typer uden arketype endnu → deres landingsside. Oprettes som arketyper senere (se planen).
const vinge = cases.find((c) => c.slug === 'daginstitution-vinge');
const hasLanding = (slug: string) => landing.some((l) => l.slug === slug);
const EXTRA: Card[] = [
  { key: 'x-lockers', name: 'Lockers med kodelås og skohylder', href: `${base}lockers`, img: morkhoj('20_lockere-roede-perforerede-laager-kodelaase-og-skohylder.jpg'), pos: '50% 45%', foto: true, fam: 'garderober', desc: 'Aflåselige rum i krydsfiner med kodelås, skohylder under og bænk foran. Til skoler og haller med mange brugere.' },
  { key: 'x-boerne', name: 'Børnegarderober med skorist', href: `${base}garderober`, img: vinge?.hero_image_url ?? '', pos: '50% 60%', foto: isPhoto(vinge?.hero_image_url), fam: 'garderober', desc: 'Ét modul pr. barn med knager foroven og dybere bund med skorist. Olieret i farver, så rækkerne deles op.' },
  { key: 'x-niche', name: 'Polstret siddeniche', href: `${base}siddenicher-og-baenke`, img: morkhoj('23_polstret-niche-roed-afrundet-hjoerne.jpg'), pos: '70% 40%', foto: true, fam: 'nicher', desc: 'Polstret niche bygget ind i væggen, med afrundede hjørner og plads til bord og stik. Til fællesarealer og gange.' },
  { key: 'x-baenke', name: 'Bænke med ryghynder', href: `${base}siddenicher-og-baenke`, img: morkhoj('25_baenke-blaa-med-ryghynder-og-mellemvaeg.jpg'), pos: '50% 55%', foto: true, fam: 'nicher', desc: 'Bænke langs væggen i krydsfiner med ryghynder og siddehynder, bygget til fællesarealer med mange brugere.' },
  { key: 'x-tavler', name: 'Glastavler og opslagstavler', href: `${base}akustik-og-glastavler`, img: morkhoj('03_klasserum-tavlevaeg-og-opslagstavler.jpg'), pos: '50% 22%', foto: true, fam: 'vaegge', desc: 'Glastavler og opslagstavler planlagt som én samlet tavlevæg i klasserummet, med akustik, hvor der er brug for det.' },
].filter((c) => c.img && hasLanding(c.href.slice(base.length)));
// Rækkefølge: de første ni er et tværsnit af familierne (fotos først); resten grupperet pr. familie
const FIRST = ['garderobeskab-perforerede-lager', 'x-lockers', 'hoejskab-krydsfiner', 'x-niche', 'x-baenke', 'koekkenvaeg-bejdset-krydsfiner', 'x-boerne', 'omklaedningsmoebel-gitterskaerm', 'hoejskab-kompaktlaminat'];
const all = [...cards, ...EXTRA];
const ordered: Card[] = [
  ...FIRST.map((k) => all.find((c) => c.key === k)).filter((c): c is Card => !!c),
  ...all.filter((c) => !FIRST.includes(c.key)).sort((a, b) => FAM_ORDER.indexOf(a.fam) - FAM_ORDER.indexOf(b.fam)),
];
const famCount = (f: string) => all.filter((c) => c.fam === f).length;

const ogImage = new URL(cdn(morkhoj('33_lockere-roede-ved-doer-til-klasserum.jpg')), site).href;
---
<Base title={title} description={description} image={ogImage} alternates={[
  { hreflang: 'da', href: new URL(base, site).href },
  { hreflang: 'en', href: new URL(base + 'en/', site).href },
  { hreflang: 'x-default', href: new URL(base, site).href },
]}>

  <!-- ============ TOPPEN ============ -->
  <header class="hero2" id="top"><div class="wrap hero2-grid">
    <div class="hero2-head">
      <span class="label">Fast inventar til byggeri</span>
      <h1>Møbler til rum med mange <em>mennesker.</em></h1>
    </div>
    <div class="hero2-cta">
      <a href={`${base}kontakt`} class="btn btn-primary">Få en pris <span class="arr">→</span></a>
      <a href="#katalog" class="btn btn-ghost">Se, hvad vi bygger <span class="arr">↓</span></a>
    </div>
    <div class="duo" id="duo" aria-label={`Fotos fra leverancen på ${projektNavn}`}>
      <div class="slot a" id="slotA">
        <img class="is-on" src={heroL[0].src} alt={heroL[0].alt} style={`--pos:${heroL[0].pos}`} fetchpriority="high" decoding="async" />
        <span class="img-tag"><b>{heroL[0].room}</b>{heroL[0].what} · {projektNavn}</span>
      </div>
      <div class="slot b" id="slotB">
        <img class="is-on" src={heroR[0].src} alt={heroR[0].alt} style={`--pos:${heroR[0].pos}`} fetchpriority="high" decoding="async" />
        <span class="img-tag"><b>{heroR[0].room}</b>{heroR[0].what} · {projektNavn}</span>
      </div>
      <button type="button" class="pausebtn" id="heroPause" aria-label="Sæt billedskiftet på pause">❚❚</button>
    </div>
    <p class="hero2-sub">Garderober, lockers, bænke, højskabe og tekøkkener til skoler, daginstitutioner og idrætshaller. Tegnet i 3D af ingeniører, bygget i vores egenproduktion og leveret efter byggepladsens tidsplan.</p>
    <div class="facts2" aria-label="Sådan arbejder vi">
      <span class="fact2">Bygget til mål</span>
      <span class="fact2">3D-render før produktion</span>
      <span class="fact2">Egen produktion</span>
      <span class="fact2">Leverer til certificeret byggeri</span>
      <span class="fact2">Delleverancer efter tidsplan</span>
    </div>
  </div></header>
  <script is:inline type="application/json" id="hero-data" set:html={JSON.stringify({ L: heroL, R: heroR, name: projektNavn })} />

  <!-- ============ TAL-STRIBE ============ -->
  <Ticker cases={cases} extra={[
    ...numbers.filter((x) => ['glastavler', 'akustik'].includes(x.t)).map((x) => ({ b: x.b, t: x.t, c: projektNavn })),
    { b: '8–12', t: 'uger', c: 'typisk fra ordre til levering' },
  ]} />

  <!-- ============ FREMHÆVET PROJEKT ============ -->
  {featured && (
    <section class="sec sec-dark" id="projekter"><div class="wrap">
      <div class="sec-head rv">
        <div>
          <span class="label">Projekter · fremhævet: {featured.name}</span>
          <h2>{headTal.map((x) => `${x.b} ${x.t}`).join(', ')}. <em>{one}</em></h2>
          <p class="lede">{featured.web_summary}</p>
        </div>
        <a href={`${base}projekter/${featured.slug}`} class="ulink">Se hele projektet →</a>
      </div>
      <div class="mos2 rv">
        {MOSAIK.map((m) => (
          <figure class={m.cls}>
            <img src={cdn(morkhoj(m.file), 1200)} alt={altFor(m.file, `${m.k}: ${m.v}`)} style={`--pos:${m.pos}`} loading="lazy" decoding="async" />
            <figcaption class="img-tag"><b>{m.k}</b>{m.v}</figcaption>
          </figure>
        ))}
      </div>
      {numbers.length > 0 && (
        <div class="talgitter rv" style={`--n:${numbers.length}`}>
          {numbers.map((x) => <div><b>{x.b}</b><span>{x.t}</span></div>)}
        </div>
      )}
      <p class="credit rv">Fotos fra leverancen. Vi har bygget inventaret — stole, borde, fliser og lamper er andres.</p>
      <div class="feat-actions rv">
        <a href={`${base}projekter/${featured.slug}`} class="btn btn-light">Se projektet <span class="arr">→</span></a>
      </div>
    </div></section>
  )}

  <!-- ============ FLERE PROJEKTER ============ -->
  <section class="sec" id="flere-projekter"><div class="wrap">
    <div class="sec-head rv">
      <div>
        <span class="label">Flere projekter</span>
        <h2>Fra udbud til <em>montage.</em></h2>
        <p class="lede">Vi tager det faste inventar som én samlet entreprise: tilbud på udbudsmaterialet, tegninger til godkendelse, egen produktion, levering i etaper efter byggepladsens tidsplan og montage.</p>
      </div>
    </div>
    <div class="pgrid rv">
      {others.map((c) => <ProjectCard c={c} />)}
      <article class="pcard ask">
        <span class="kick">Jeres byggeri</span>
        <h3>Send tegninger eller udbud</h3>
        <p>Vi læser materialet og vender tilbage med de spørgsmål, der skal afklares — og et tilbud med 3D og dokumentation, I kan holde op mod udbuddet.</p>
        <a href={`${base}kontakt`} class="btn btn-primary">Start et projekt <span class="arr">→</span></a>
      </article>
    </div>
  </div></section>

  <!-- ============ INVENTAR (kataloget) ============ -->
  <section class="sec inv" id="katalog"><div class="wrap">
    <div class="sec-head rv">
      <div>
        <span class="label">Inventar</span>
        <h2>Konstruktionen er løst. Målene er <em>jeres.</em></h2>
        <p class="lede">Typerne i kataloget er gennemarbejdet fra samling til overflade. I vælger mål, materiale og farve og ser resultatet i 3D med pris, før I bestiller. Mangler I en type, tegner vi den.</p>
      </div>
      <a href={`${base}kontakt`} class="ulink">Mangler I noget særligt? →</a>
    </div>
    <div class="filters rv" id="filters" role="group" aria-label="Filtrér typer">
      <button type="button" class="fchip on" data-f="alle">Alle<small>{all.length}</small></button>
      {FAM_ORDER.map((f) => <button type="button" class="fchip" data-f={f}>{FAM[f]}<small>{famCount(f)}</small></button>)}
    </div>
    <div class="types rv" id="types">
      {ordered.map((c) => <ProductCard name={c.name} href={c.href} img={c.img} pos={c.pos} tag={fotoTag(c.foto, projektNavn)} fam={FAM[c.fam]} desc={c.desc} dataFam={c.fam} />)}
    </div>
    <div class="showmore-row" id="showmoreRow"><button type="button" class="btn btn-ghost" id="showmore">Vis alle {all.length} typer <span class="arr">↓</span></button></div>

    <!-- Det laver vi: landingssider pr. emne, målgruppe og guide (ankeret #ydelser bruges af alle landingssider) -->
    <div class="yd-links rv" id="ydelser">
      {segmenter.length > 0 && (
        <div class="yd-row"><span class="lbl">Til:</span>{segmenter.map((l) => <a class="pill" href={`${base}${l.slug}`}>{l.nav_label}</a>)}</div>
      )}
      {emner.length > 0 && (
        <div class="yd-row"><span class="lbl">Materialer og inventar:</span>{emner.map((l) => <a class="pill" href={`${base}${l.slug}`}>{l.nav_label}</a>)}</div>
      )}
      {guides.length > 0 && (
        <div class="yd-row"><span class="lbl">Guides:</span>{guides.map((l) => <a class="pill" href={`${base}${l.slug}`}>{l.nav_label}</a>)}</div>
      )}
    </div>
  </div></section>

  <!-- ============ DESIGNEREN (kommer snart) ============ -->
  <section class="sec designer" id="designer"><div class="wrap">
    <div class="sec-head rv" style="margin-bottom:36px">
      <div>
        <span class="label">Designeren · kommer snart</span>
        <h2>Se prisen, mens skabet tager <em>form.</em></h2>
        <p class="lede">Sæt bredde, højde og dybde med skyderne, og se skabet i 3D. Vælg materiale, farve, indretning, låge og greb — prisen går op og ned med hvert valg. Prøv, hvordan det kommer til at virke:</p>
      </div>
    </div>
    <DesignerTeaser />
  </div></section>

  <!-- ============ FRA 3D-MODEL TIL FÆRDIGT RUM ============ -->
  <section class="sec" id="saadan"><div class="wrap">
    <div class="sec-head rv">
      <div>
        <span class="label">Sådan arbejder vi</span>
        <h2>Fra 3D-model til <em>færdigt rum.</em></h2>
        <p class="lede">Holdet er ingeniører. Hvert skab, hver bænk og hver niche bygges først som 3D-model; samme model giver tegningen til jeres godkendelse og styklisten til produktionen.</p>
      </div>
      {hasLanding('vaerkstedstegninger-og-3d-model') && <a href={`${base}vaerkstedstegninger-og-3d-model`} class="ulink">Sådan ser tegningerne ud →</a>}
    </div>
    <ProcessSteps />
  </div></section>

  <!-- ============ HVAD VI STÅR FOR ============ -->
  <section class="sec values" id="staar-for" style="padding-top:0"><div class="wrap">
    <div class="sec-head rv">
      <div>
        <span class="label">Det, vi står for</span>
        <h2>Fire ting, vi lægger <em>vægt på.</em></h2>
      </div>
    </div>
    <div class="vgrid rv">
      <div class="v"><span class="n">I.</span><h3>Håndværket</h3><p>Samlinger, kanter og overflader vælges efter, hvor hårdt rummet bliver brugt. Overfladen kan repareres på stedet, så inventaret kan holdes pænt i mange år.</p></div>
      <div class="v"><span class="n">II.</span><h3>Det digitale</h3><p>Hvert stykke inventar tegnes og renderes i 3D, før produktionen starter. I godkender det, I faktisk får, før vi skærer den første plade.</p></div>
      <div class="v"><span class="n">III.</span><h3>Dokumentationen</h3><p>Produktdatablade, indeklimadokumentation og EPD'er, hvor producenten har dem, på de materialer vi bruger. Samlet og afleveret sammen med inventaret.</p></div>
      <div class="v"><span class="n">IV.</span><h3>Samarbejdet</h3><p>Vi taler arkitekters og entreprenørers sprog: tegningslæsning, rumskemaer, tilsyn og delleverancer, der følger byggepladsens tidsplan.</p></div>
    </div>
  </div></section>

  <!-- ============ OVERFLADEN · Nem Inventar × Rubio Monocoat (plan: scratchpad/overfladen-plan.md, Opus 04-10-2026) ============ -->
  <section class="sec finish" id="overflade"><div class="wrap">
    <div class="ov-top rv">
      <div class="ov-head">
        <span class="label">Overfladen</span>
        <h2>Olieret med <em>Rubio&nbsp;Monocoat.</em></h2>
        <p class="ov-lede">Vi har valgt det, fordi det holder inventaret pænt længst: olien binder sig i træet, og slid kan repareres pletvis.</p>
      </div>
      <aside class="ov-partner" aria-label="Samarbejde mellem Nem Inventar og Rubio Monocoat">
        <p class="ov-lockup"><span>Nem Inventar</span><span><i aria-hidden="true">×</i> Rubio Monocoat</span></p>
        <div class="ov-partner-foot">
          <p>Rubio Monocoat har blandet de to kulører til {projektNavn} specielt til os.</p>
          <a href="https://www.rubiomonocoat.dk/" target="_blank" rel="noopener">Rubio Monocoat Denmark ↗</a>
        </div>
      </aside>
    </div>

    <div class="ov-photos rv">
      <figure class="ov-fig">
        <a class="rpic" href={`${base}projekter/${PHOTO_PROJECT_SLUG}`} aria-label={`Se projektet ${projektNavn}`}>
          <img src={cdn(morkhoj('35_detalje-haengsel-og-perforering-roed-laage.jpg'))} alt="Rødbrun locker-låge i krydsfiner med perforering og hængsel" loading="lazy" decoding="async" style="--pos:40% 50%" />
        </a>
        <figcaption>Rødbrun på lockerlåger. {projektNavn}.</figcaption>
      </figure>
      <figure class="ov-fig">
        <a class="rpic" href={`${base}projekter/${PHOTO_PROJECT_SLUG}`} aria-label={`Se projektet ${projektNavn}`}>
          <img src={cdn(morkhoj('27_hoejskab-blaa-krydsfiner-og-siddepladser.jpg'))} alt="Blåt højskab i krydsfiner — låger med synlig åretegning og bøjlegreb" loading="lazy" decoding="async" style="--pos:50% 30%;--zoom:1.55;--origin:69% 38%" />
        </a>
