  <script>
    // ---------- toppen: to felter, der skifter ét ad gangen. Første skift efter ca. 1 sekund ----------
    (() => {
      const dataEl = document.getElementById('hero-data');
      const duo = document.getElementById('duo');
      const pauseBtn = document.getElementById('heroPause');
      if (!dataEl || !duo || !pauseBtn) return;
      type Item = { src: string; pos: string; alt: string; room: string; what: string };
      const data = JSON.parse(dataEl.textContent || '{}') as { L: Item[]; R: Item[]; name: string };
      type Slot = { el: HTMLElement; pool: Item[]; i: number; imgs: (HTMLImageElement | null)[]; tag: HTMLElement };
      const mk = (id: string, pool: Item[]): Slot | null => {
        const el = document.getElementById(id); if (!el) return null;
        const first = el.querySelector('img'); const tag = el.querySelector<HTMLElement>('.img-tag');
        if (!first || !tag) return null;
        return { el, pool, i: 0, imgs: pool.map((_, k) => (k === 0 ? first : null)), tag };
      };
      const slots = [mk('slotA', data.L), mk('slotB', data.R)].filter((s): s is Slot => !!s);
      if (!slots.length) return;
      const mq = matchMedia('(max-width: 860px)');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const FIRST = 1100, STEP = 3200;
      let first: number | undefined, timer: number | undefined, turn = 0, userPaused = false, hover = false;
      // billederne hentes først, når de skal bruges — det næste gøres klar, så overblændingen aldrig viser et tomt felt
      const ensure = (s: Slot, k: number) => {
        k = (k + s.pool.length) % s.pool.length;
        if (!s.imgs[k]) {
          const it = s.pool[k], im = new Image();
          im.src = it.src; im.alt = it.alt; im.decoding = 'async'; im.style.setProperty('--pos', it.pos);
          s.el.insertBefore(im, s.tag); s.imgs[k] = im;
        }
        return s.imgs[k]!;
      };
      const show = (s: Slot, k: number) => {
        s.i = (k + s.pool.length) % s.pool.length;
        ensure(s, s.i);
        s.el.classList.add('swapping');
        s.imgs.forEach((im, j) => im && im.classList.toggle('is-on', j === s.i));
        window.setTimeout(() => { const it = s.pool[s.i]; s.tag.innerHTML = `<b>${it.room}</b>${it.what} · ${data.name}`; s.el.classList.remove('swapping'); }, 300);
        ensure(s, s.i + 1);
      };
      const canRun = () => !reduce && !userPaused && !hover;
      const tick = () => { if (mq.matches || slots.length === 1) { const s = slots[slots.length - 1]; show(s, s.i + 1); return; } turn = 1 - turn; show(slots[turn], slots[turn].i + 1); };
      const stop = () => { clearTimeout(first); clearInterval(timer); first = timer = undefined; pauseBtn.textContent = '▶'; pauseBtn.setAttribute('aria-label', 'Start billedskiftet'); };
      const start = (delay: number) => { stop(); if (!canRun()) return; pauseBtn.textContent = '❚❚'; pauseBtn.setAttribute('aria-label', 'Sæt billedskiftet på pause'); first = window.setTimeout(() => { tick(); timer = window.setInterval(tick, STEP); }, delay); };
      pauseBtn.addEventListener('click', () => { userPaused = !userPaused; if (userPaused) stop(); else start(300); });
      duo.addEventListener('mouseenter', () => { hover = true; stop(); });
      duo.addEventListener('mouseleave', () => { hover = false; start(1200); });
      slots[slots.length - 1].el.addEventListener('click', () => { if (mq.matches) { const s = slots[slots.length - 1]; show(s, s.i + 1); start(STEP); } });   // telefon: tryk = næste
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start(800)));
      window.setTimeout(() => slots.forEach((s) => ensure(s, 1)), 600);
      start(FIRST);
    })();

    // ---------- inventar: filtre + "vis alle" ("Alle" viser 9 på computer, 6 på telefon; et filter viser hele familien) ----------
    (() => {
      const types = document.getElementById('types'), more = document.getElementById('showmore'), row = document.getElementById('showmoreRow');
      if (!types || !more || !row) return;
      const cards = Array.from(types.querySelectorAll<HTMLElement>('.tcard'));
      const chips = Array.from(document.querySelectorAll<HTMLElement>('#filters .fchip'));
      let f = 'alle', expanded = false;
      const apply = () => {
        cards.forEach((t) => { t.hidden = !(f === 'alle' || t.dataset.fam === f); });
        chips.forEach((c) => c.classList.toggle('on', c.dataset.f === f));
        types.classList.toggle('expanded', expanded || f !== 'alle');
        row.hidden = expanded || f !== 'alle';
      };
      chips.forEach((c) => c.addEventListener('click', () => { f = c.dataset.f || 'alle'; apply(); }));
      more.addEventListener('click', () => { expanded = true; apply(); });
      apply();
    })();
  </script>
