---
// Bevisbjælken under toppen (forside v3): ét tal fra hver af fire forskellige sager, så det ikke ligner én sag.
// Tallene parses fra case_web.delivery_label; sagerne vælges i src/lib/forside.ts (BEVIS_SAGER).
import type { WebCase } from '../lib/supabase';
import { BEVIS_SAGER, bevis } from '../lib/forside';
interface Props { cases: WebCase[] }
const { cases } = Astro.props;
const base = import.meta.env.BASE_URL;
const rows = BEVIS_SAGER.map((s) => cases.find((c) => c.slug === s)).filter((c): c is WebCase => !!c)
  .map((c) => ({ c, t: bevis(c) })).filter((x) => !!x.t);
---
{rows.length > 0 && (
  <section class="proof" aria-label="Fra leverancerne"><div class="wrap">
    {rows.map(({ c, t }) => (
      <a href={`${base}projekter/${c.slug}`}><b>{t!.b}</b><span>{t!.t} · {c.name}</span></a>
    ))}
  </div></section>
)}
<style>
  .proof{border-block:1px solid var(--line);background:#fff}
  .proof .wrap{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
  .proof a{padding:22px 20px;border-left:1px solid var(--line);text-decoration:none;color:inherit;transition:background .2s}
  .proof a:hover{background:var(--paper)}
  .proof a:first-child{border-left:0;padding-left:0}
  .proof b{display:block;font-family:'Archivo',sans-serif;font-size:32px;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1.1}
  .proof span{font-size:14px;color:var(--muted)}
  @media (max-width:900px){
    .proof .wrap{grid-template-columns:1fr 1fr}
    .proof a{border-left:0;padding-left:0;border-top:1px solid var(--line)}
    .proof a:nth-child(-n+2){border-top:0}
  }
</style>
