---
// Typesiden (arketype) på begge sprog: /produkter/<slug>/ og /en/products/<engelsk slug>/ (20-11-2026, så de to ikke
// kan glide fra hinanden). Indhold fra v_web_products; den engelske tekst fra lib/engelsk.ts. Varianter (D4) fra
// images_meta: én vælger under hovedbilledet med typen i hver kulør, og "Få pris på denne" følger den valgte (Joachim
// 05-10-2026: "Hvorfor kører vi med 2?"). Fotoet fra leverancen (lib/catalog PHOTO) er ikke en variant og står for sig
// som et rigtigt eksempel. Projekter og landingssider, der nævner typen, vises nedenunder.
import Base from '../../layouts/Base.astro';
import CallbackForm from '../CallbackForm.tsx';
import ProductCard from '../ProductCard.astro';
import ProjectCard from '../ProjectCard.astro';
import ContactCta from '../ContactCta.astro';
import type { WebProduct, WebCase, WebLanding, WebColor } from '../../lib/supabase';
import { cdn } from '../../lib/img';
import { chipLabels } from '../../lib/labels';
import { famOf, famNavn, productImage, typeBillede, fotoTag, isPhoto } from '../../lib/catalog';
import { DESIGNER_AF, designerLink } from '../../lib/forside';
import { varianterAf, prisHref } from '../../lib/varianter';
import { side, designerSprog } from '../../lib/stier';
import { typePaaEngelsk, produkterPaaEngelsk, sagerPaaEngelsk, landingPaaEngelsk, kuloerNavn, typeHref, sagHref, landingHref, harTypeEn } from '../../lib/engelsk';
// Standardudgavens pris i designeren (scripts/produkt_priser.py, designerens egen prismodel). Står synligt på siden og
// i Product/Offer, så Google og AI-assistenter kan læse den (lockers-SEO 08-11-2026: produktsiderne havde ingen pris).
import produktPriser from '../../data/produkt-priser.json';

interface Props { product: WebProduct; products: WebProduct[]; cases: WebCase[]; landing: WebLanding[]; colors: WebColor[]; lang?: 'da' | 'en' }
const { lang = 'da' } = Astro.props;
const en = lang === 'en';
const daProduct = Astro.props.product;
// På engelsk: alt, hvad siden viser, i den engelske udgave. Typer, sager og landingssider uden oversættelse falder fra.
const product = en ? typePaaEngelsk(daProduct)! : daProduct;
const products = en ? produkterPaaEngelsk(Astro.props.products).filter((p) => harTypeEn(p.slug)) : Astro.props.products;
const cases = en ? sagerPaaEngelsk(Astro.props.cases) : Astro.props.cases;
const landing = en ? Astro.props.landing.flatMap((l) => (landingPaaEngelsk(l) ? [landingPaaEngelsk(l)!] : [])) : Astro.props.landing;
const colors = Astro.props.colors;
const base = import.meta.env.BASE_URL;
const site = Astro.site!;
const materials = chipLabels(product.materials, lang);
const finishes = chipLabels(product.finishes, lang);
const applications = chipLabels(product.applications, lang);
const paragraphs = (product.story ?? product.short_description ?? '').split('\n\n').filter(Boolean);
const fam = famOf(product);

const T = en ? {
  back: '← The catalogue', vaelg: 'Choose colour', altI: (navn: string, l: string) => `${navn} in ${l.toLowerCase()}`,
  fotoAlt: (navn: string) => `${navn}, photo from a delivery`, fotoTaet: 'From a delivery, close up.', fotoRum: 'From a delivery: what the type looks like in a real room.',
  materialer: 'Materials', overflade: 'Finish', velegnet: 'Suitable for',
  farveFaq: { q: 'Can I get other colours?', a: 'Yes, of course. Here we show the colours we keep in stock. The oil, the laminate and the fabric come in many more colours, and from a sample or a RAL or NCS code we find the closest match. Write the colour in your enquiry.' },
  prisLinje: (link: string, inkl: string, ex: string) => `<b>The standard version in the designer: <a href="${link}">DKK ${inkl}</a></b> incl. VAT (DKK ${ex} excl. VAT for businesses), excl. delivery · change the size and number, and the price follows · drawn in 3D for approval before we build · prices for delivery in Denmark`,
  tilMaal: '<b>Made to measure</b> · priced from a site survey · drawn in 3D for approval before we build',
  prisKnap: 'Get a quote for this', ring: 'Call us',
  designer: (locker: boolean) => `Build the ${locker ? 'lockers' : 'cabinets'} yourself in 3D: size, colour and number. Architects can download the model as IFC for Revit and ArchiCAD.`,
  aabn: 'Open the designer →', ifc: 'Download IFC →',
  projLabel: 'From our projects', projH: ['Projects with furniture from the same', 'family.'],
  projLede: (f: string) => `Projects where we have built ${f.toLowerCase()}, drawn for the room, built in our own production and installed by us.`,
  alleProj: 'All projects →', invLabel: 'Products', andreH: ['Other types in the', 'catalogue.'],
  andreLede: 'The construction is worked out. The measurements are yours: you choose size, material and colour, and we draw it in 3D before we build.',
  hele: 'The whole catalogue →', laesMere: 'Read more:', breadcrumb: 'Products', katalog: 'Products',
} : {
  back: '← Kataloget', vaelg: 'Vælg kulør', altI: (navn: string, l: string) => `${navn} i ${l.toLowerCase()}`,
  fotoAlt: (navn: string) => `${navn}, foto fra en leverance`, fotoTaet: 'Fra en leverance, tæt på.', fotoRum: 'Fra en leverance: sådan ser typen ud i et rigtigt rum.',
  materialer: 'Materialer', overflade: 'Overflade', velegnet: 'Velegnet til',
  // Andre farver (Joachim 06-10-2026: "Kan man få andre farver??? Og så sige ja selvfølgelig."). Gælder alle typer.
  farveFaq: { q: 'Kan man få andre farver?', a: 'Ja, selvfølgelig. Her viser vi de farver, vi har på lager. Olien, laminatet og stoffet findes i mange flere farver, og ud fra en prøve eller en RAL- eller NCS-kode finder vi den, der ligger tættest på. Skriv farven i forespørgslen.' },
  prisLinje: null as null | ((link: string, inkl: string, ex: string) => string),
  tilMaal: null as null | string,
  prisKnap: 'Få pris på denne', ring: 'Ring',
  designer: (locker: boolean) => `Byg ${locker ? 'lockerne' : 'skabene'} selv i 3D: mål, kulør og antal. Arkitekter kan hente modellen som IFC til Revit og ArchiCAD.`,
  aabn: 'Åbn designeren →', ifc: 'Hent IFC →',
  projLabel: 'Fra vores projekter', projH: ['Sager med inventar i samme', 'familie.'],
  projLede: (f: string) => `Projekter, hvor vi har bygget ${f.toLowerCase()} — tegnet til rummet, bygget i vores egenproduktion og monteret af os.`,
  alleProj: 'Alle projekter →', invLabel: 'Inventar', andreH: ['Andre typer i', 'kataloget.'],
  andreLede: 'Konstruktionen er løst. Målene er jeres: I vælger mål, materiale og farve, og vi tegner det i 3D, før vi bygger.',
  hele: 'Hele kataloget →', laesMere: 'Læs mere om:', breadcrumb: 'Inventar', katalog: 'Inventar',
};

// Varianter: typen i hver kulør, vi har en render af. Hovedbilledet starter på den første.
// Uden varianter (bør ikke ske) vises typens billede som før. Kulørens navn på sidens sprog.
const varianter = varianterAf(product, colors).map((v) => ({ ...v, label: kuloerNavn(v.kuloer, v.label, lang) }));
const v0 = varianter[0] ?? null;
const pi = productImage(product);
const mainImg = v0?.img ?? pi.img;
const altAf = (label?: string) => (label ? T.altI(product.name, label) : product.name);
// Fotoet fra leverancen: et rigtigt eksempel, ikke et valg. Er typens foto selv en variant (mobil-lockers 08-10-2026:
// fotoet er klar olie), vises i stedet et foto uden kulør (en detalje) — aldrig det samme billede to gange.
const iVariant = (src: string) => varianter.some((v) => v.img === src);
const ekstraFoto = (product.images_meta ?? []).find((m) => !m.color && isPhoto(m.url))?.url ?? null;
const foto = pi.foto && !iVariant(pi.img) ? pi.img : ekstraFoto;
const fotoTekst = foto && foto === ekstraFoto ? T.fotoTaet : T.fotoRum;
const designerProdukt = DESIGNER_AF[product.slug];
// Designeren og IFC-filen åbner i den valgte kulør (lib/forside designerLink); null for typer uden model i designeren.
// På engelsk åbner designeren på engelsk (?lang=en, #71).
const medSprog = (u: string | null) => (u ? designerSprog(u, lang) : u);
const dLink = (k?: string) => medSprog(designerLink(product.slug, k)) ?? undefined;
const ifcLink = (k?: string) => medSprog(designerLink(product.slug, k, 'ifc')) ?? undefined;
const kontaktSti = side(lang, 'kontakt');
const pHref = (v: { slug: string; navn: string; kuloer?: string; label?: string }) => prisHref(base, v, kontaktSti);

// Landingssider, der nævner typen, og projekterne de peger på (data, ikke gæt)
const relLanding = landing.filter((l) => (l.product_slugs ?? []).includes(product.slug));
const caseSlugs = [...new Set(relLanding.flatMap((l) => l.case_slugs ?? []))];
const relCases = caseSlugs.map((s) => cases.find((c) => c.slug === s)).filter((c): c is WebCase => !!c).slice(0, 3);
// Andre typer: samme familie først, derefter resten
const others = [...products.filter((p) => p.slug !== product.slug && famOf(p) === fam), ...products.filter((p) => p.slug !== product.slug && famOf(p) !== fam)].slice(0, 3);

const FARVE_FAQ = T.farveFaq;
const pris = (produktPriser.priser as Record<string, { inkl: number; ex: number; link: string }>)[product.slug] ?? null;
const kr = (n: number) => (en ? n.toLocaleString('en-GB') : n.toLocaleString('da-DK'));
const egenSti = typeHref(lang, product.slug);
const produktUrl = new URL(`${base}${en ? egenSti : `produkter/${product.slug}/`}`, site).href;
const alternates = harTypeEn(product.slug) ? [
  { hreflang: 'da', href: new URL(`${base}produkter/${product.slug}/`, site).href },
  { hreflang: 'en', href: new URL(base + typeHref('en', product.slug), site).href },
] : [];
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.seo_description ?? product.short_description ?? undefined,
  image: mainImg ? new URL(cdn(mainImg, 1200), site).href : undefined,
  url: produktUrl,
  category: famNavn(fam, lang),
  material: materials.length ? materials.join(', ') : undefined,
  brand: { '@type': 'Brand', name: 'Nem Inventar' },
  ...(pris ? {
    offers: {
      '@type': 'Offer',
      url: pris.link,
      price: pris.inkl,
      priceCurrency: 'DKK',
      priceSpecification: { '@type': 'UnitPriceSpecification', price: pris.inkl, priceCurrency: 'DKK', valueAddedTaxIncluded: true },
      availability: 'https://schema.org/MadeToOrder',
      itemCondition: 'https://schema.org/NewCondition',
      seller: { '@type': 'Organization', name: 'Nem Inventar ApS', url: new URL(base, site).href },
    },
  } : {}),
}, {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Nem Inventar', item: new URL(base + side(lang, 'forside'), site).href },
    { '@type': 'ListItem', position: 2, name: T.breadcrumb, item: new URL(base + side(lang, 'inventar'), site).href },
    { '@type': 'ListItem', position: 3, name: product.name, item: en ? produktUrl : new URL(`${base}produkter/${product.slug}`, site).href },
  ],
}, {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  ...(en ? { inLanguage: 'en' } : {}),
  mainEntity: [{ '@type': 'Question', name: FARVE_FAQ.q, acceptedAnswer: { '@type': 'Answer', text: FARVE_FAQ.a } }],
}];
const foraeldet = en && (product as { foraeldet?: boolean }).foraeldet ? `type/${daProduct.slug}` : undefined;
---
<Base lang={lang} title={product.seo_title} description={product.seo_description} image={mainImg ? cdn(mainImg, 1200) : undefined} jsonLd={jsonLd} alternates={alternates} foraeldet={foraeldet}>
  <section class="pd"><div class="wrap">
    <div class="crumbrow"><a href={`${base}${side(lang, 'inventar')}`} class="crumb">{T.back}</a></div>
    <div class="pd-grid">
      <div class="gallery" id="galleri">
        {mainImg && (
          <figure class="pd-main">
            <img id="main-img" src={cdn(mainImg, 1200)} alt={altAf(v0?.label)} style={v0 ? undefined : `--pos:${pi.pos}`} fetchpriority="high" />
            <span class="ptag" id="main-tag">{fotoTag(v0 ? isPhoto(v0.img) : pi.foto, lang)}</span>
          </figure>
        )}
        {varianter.length > 1 && (
          <div class="vtiles" role="group" aria-label={T.vaelg}>
            {varianter.map((v, i) => (
              <a class={`vtile${i === 0 ? ' active' : ''}`} href={`#${v.id}`} data-v={v.id} data-src={cdn(v.img, 1200)} data-tag={fotoTag(isPhoto(v.img), lang)}
                 data-alt={altAf(v.label)} data-label={v.label} data-pris={pHref(v)} data-designer={dLink(v.kuloer)} data-ifc={ifcLink(v.kuloer)}
                 aria-current={i === 0 ? 'true' : undefined}>
                <img src={cdn(v.img, 480)} alt={altAf(v.label)} loading="lazy" decoding="async" />
                <span>{v.hex && <i style={`background:${v.hex}`}></i>}{v.label}</span>
              </a>
            ))}
          </div>
        )}
        {foto && (
          <figure class="pd-foto">
            <img src={cdn(foto, 1000)} alt={T.fotoAlt(product.name)} style={`--pos:${foto === ekstraFoto ? '50% 50%' : pi.pos}`} loading="lazy" decoding="async" />
            <figcaption>{fotoTekst}</figcaption>
          </figure>
        )}
      </div>
      <div class="detail-body">
        <span class="kicker">{famNavn(fam, lang)}</span>
        <h1>{product.name}</h1>
        {product.hero_tagline && <p class="lead">{product.hero_tagline}</p>}
        <div class="prose">
          {paragraphs.map((para) => <p>{para}</p>)}
        </div>
        <div class="pd-spec">
          {materials.length > 0 && <div class="row"><span class="k">{T.materialer}</span><div class="chips">{materials.map((m) => <span>{m}</span>)}</div></div>}
          {finishes.length > 0 && <div class="row"><span class="k">{T.overflade}</span><div class="chips">{finishes.map((f) => <span>{f}</span>)}</div></div>}
          {applications.length > 0 && <div class="row"><span class="k">{T.velegnet}</span><div class="chips">{applications.map((a) => <span>{a}</span>)}</div></div>}
        </div>
        <details class="pd-faq"><summary>{FARVE_FAQ.q}</summary><p>{FARVE_FAQ.a}</p></details>
        {en
          ? (pris ? <p class="pd-made" set:html={T.prisLinje!(designerSprog(pris.link, lang), kr(pris.inkl), kr(pris.ex))} /> : <p class="pd-made" set:html={T.tilMaal!} />)
          : pris
          ? <p class="pd-made"><b>Standardudgaven i designeren: <a href={pris.link}>{kr(pris.inkl)} kr.</a></b> inkl. moms ({kr(pris.ex)} kr. ekskl. moms for virksomheder), ekskl. levering · ændr mål og antal, så følger prisen med · tegnet i 3D til godkendelse, før vi bygger</p>
          : <p class="pd-made"><b>Til mål</b> · pris efter opmåling · tegnet i 3D til godkendelse, før vi bygger</p>}
        <div class="detail-cta">
          <a id="pris-knap" href={pHref(v0 ?? { slug: product.slug, navn: product.name })} class="btn btn-primary">{T.prisKnap}<span id="pris-label">{v0 && varianter.length > 1 ? ` · ${v0.label}` : ''}</span> <span class="arr">→</span></a>
          <a href="tel:+4542422684" class="btn btn-ghost">+45 42 42 26 84</a>
          {en ? <CallbackForm client:load lang="en" /> : <CallbackForm client:load />}
        </div>
        {designerProdukt && dLink(v0?.kuloer) && (
          <p class="pd-designer"><span>{T.designer(designerProdukt === 'locker')}</span>
            <span class="pd-dlinks"><a id="designer-knap" href={dLink(v0?.kuloer)}>{T.aabn}</a><a id="ifc-knap" href={ifcLink(v0?.kuloer)}>{T.ifc}</a></span></p>
        )}
      </div>
    </div>
  </div></section>

  {relCases.length > 0 && (
    <section class="sec" id="projekter"><div class="wrap">
      <div class="sec-head rv">
        <div>
          <span class="label">{T.projLabel}</span>
          <h2>{T.projH[0]} <em>{T.projH[1]}</em></h2>
          <p class="lede">{T.projLede(famNavn(fam, lang))}</p>
        </div>
        <a href={`${base}${side(lang, 'projekter')}`} class="ulink">{T.alleProj}</a>
      </div>
      <div class={`pgrid rv${relCases.length > 2 ? ' three' : ''}`}>
        {relCases.map((c) => <ProjectCard c={c} compact={relCases.length > 2} lang={lang} />)}
      </div>
    </div></section>
  )}

  {others.length > 0 && (
    <section class="sec inv" id="andre"><div class="wrap">
      <div class="sec-head rv">
        <div>
          <span class="label">{T.invLabel}</span>
          <h2>{T.andreH[0]} <em>{T.andreH[1]}</em></h2>
          <p class="lede">{T.andreLede}</p>
        </div>
        <a href={`${base}${side(lang, 'inventar')}`} class="ulink">{T.hele}</a>
      </div>
      <div class="types all rv">
        {others.map((p) => { const im = typeBillede(p, colors); return (
          <ProductCard name={p.name} href={`${base}${typeHref(lang, p.slug)}`} img={im.img} pos={im.pos} tag={fotoTag(im.foto, lang)} fam={famNavn(famOf(p), lang)} desc={p.intro ?? p.short_description ?? ''} lang={lang} />
        ); })}
      </div>
      {relLanding.length > 0 && (
        <div class="yd-row rv" style="margin-top:36px"><span class="lbl">{T.laesMere}</span>{relLanding.map((l) => <a class="pill" href={`${base}${landingHref(lang, l.slug)}`}>{l.nav_label}</a>)}</div>
      )}
    </div></section>
  )}

  <ContactCta subject={product.name} lang={lang} />

  <style>
    .vtiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:12px}
    .vtile{display:flex;flex-direction:column;gap:6px;border:1px solid var(--line);border-radius:12px;padding:6px;background:#fff;color:var(--muted);font-size:13.5px;font-weight:500;line-height:1.25;transition:border-color .2s}
    .vtile img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:8px}
    .vtile span{display:flex;align-items:center;gap:6px;padding:0 2px 2px}
    .vtile i{width:12px;height:12px;border-radius:50%;flex:none;border:1px solid rgba(23,20,14,.18)}
    .vtile:hover{border-color:var(--warm-soft)}
    .vtile.active{border-color:var(--warm);box-shadow:0 0 0 1px var(--warm);color:var(--ink)}
    .pd-dlinks{display:flex;flex-direction:column;gap:6px;flex:none}
    @media (max-width:600px){.pd-designer{flex-direction:column;align-items:flex-start}.pd-dlinks{flex-direction:row;gap:16px}}
    .pd-faq{margin-top:18px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:10px 0}
    .pd-faq summary{cursor:pointer;font-weight:600;font-size:15px}
    .pd-faq p{margin:8px 0 2px;font-size:14.5px;color:var(--muted);max-width:60ch}
    .pd-foto{margin:22px 0 0;border-top:1px solid var(--line);padding-top:18px}
    .pd-foto img{width:100%;aspect-ratio:16/9;object-fit:cover;object-position:var(--pos,50% 50%);border-radius:14px}
    .pd-foto figcaption{font-size:13.5px;color:var(--muted);margin-top:8px}
    @media (max-width:600px){.vtiles{grid-template-columns:1fr 1fr}}
  </style>
  <script>
    // Vælgeren: billedet, alt-teksten og "Få pris på denne" følger den valgte kulør. #v-<kulør> (fra forsiden) vælger.
    // Billederne bærer data-v, ikke id, så Base.astro's anker-rulning ikke trækker siden ned til vælgeren.
    const main = document.getElementById('main-img') as HTMLImageElement | null;
    const knap = document.getElementById('pris-knap') as HTMLAnchorElement | null;
    const label = document.getElementById('pris-label');
    const tiles = Array.from(document.querySelectorAll<HTMLAnchorElement>('.vtile'));
    const dKnap = document.getElementById('designer-knap') as HTMLAnchorElement | null;
    const ifcKnap = document.getElementById('ifc-knap') as HTMLAnchorElement | null;
    const tag = document.getElementById('main-tag');
    const vaelg = (t: HTMLAnchorElement) => {
      const { src, alt, label: l, pris, designer, ifc, tag: mærke } = t.dataset;
      if (tag && mærke) tag.textContent = mærke;   // foto eller visualisering følger det valgte billede
      if (dKnap && designer) dKnap.href = designer;
      if (ifcKnap && ifc) ifcKnap.href = ifc;
      if (main && src) { main.style.opacity = '0'; main.onload = () => { main.style.opacity = '1'; }; main.src = src; if (alt) main.alt = alt; if (main.complete) main.style.opacity = '1'; }
      if (knap && pris) knap.href = pris;
      if (label) label.textContent = l ? ` · ${l}` : '';
      tiles.forEach((x) => { x.classList.toggle('active', x === t); if (x === t) x.setAttribute('aria-current', 'true'); else x.removeAttribute('aria-current'); });
    };
    tiles.forEach((t) => t.addEventListener('click', (e) => { e.preventDefault(); vaelg(t); history.replaceState(null, '', '#' + t.dataset.v); }));
    const fra = tiles.find((t) => '#' + t.dataset.v === location.hash);
    if (fra) vaelg(fra);
  </script>
</Base>
