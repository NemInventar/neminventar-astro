---
// Projektsiden på begge sprog: /projekter/<slug>/ og /en/projects/<engelsk slug>/. Indhold fra v_web_cases (case_web);
// den engelske tekst fra lib/engelsk.ts. Fotos fra leverancen vises først og størst; visualiseringer for sig og mærket.
// Tal fra leverancen (delivery_label) bliver til et talgitter. Lysboks til fuld størrelse.
import Base from '../../layouts/Base.astro';
import ProjectCard from '../ProjectCard.astro';
import ContactCta from '../ContactCta.astro';
import type { WebCase } from '../../lib/supabase';
import { cdn } from '../../lib/img';
import { caseMeta, isPhoto, leverance, tal, imgLabel } from '../../lib/catalog';
import { side, kontaktMedEmne } from '../../lib/stier';
import { sagPaaEngelsk, sagerPaaEngelsk, sagHref, harSagEn } from '../../lib/engelsk';

interface Props { project: WebCase; cases: WebCase[]; lang?: 'da' | 'en' }
const { lang = 'da' } = Astro.props;
const en = lang === 'en';
const project = en ? sagPaaEngelsk(Astro.props.project)! : Astro.props.project;
const cases = en ? sagerPaaEngelsk(Astro.props.cases).filter((c) => harSagEn(c.slug)) : Astro.props.cases;
const paragraphs = (project.web_story ?? '').split('\n\n').filter(Boolean);
const desc = project.seo_description ?? (project.web_summary ?? '').slice(0, 200);
const base = import.meta.env.BASE_URL;
const site = Astro.site!;
const gallery = project.gallery ?? [];
const heroItem = gallery.find((g) => g.src === project.hero_image_url);
const heroIsPhoto = heroItem ? heroItem.kind === 'foto' : isPhoto(project.hero_image_url);
const fotos = gallery.filter((g) => g.kind === 'foto' && g.src !== project.hero_image_url);
const andre = gallery.filter((g) => g.kind !== 'foto' && g.kind !== 'video' && g.src !== project.hero_image_url);
const meta = caseMeta(project, lang);
const numbers = tal(project);
const items = leverance(project);
const others = cases.filter((c) => c.slug !== project.slug).slice(0, 3);
// Samarbejdspartnere på sagen (case_web.web_partners) — fx Rubio Monocoat på Mørkhøj Skole
const partners = project.web_partners && project.web_partners.text ? project.web_partners : null;

const T = en ? {
  alle: '← All projects', lignende: 'Similar project: ', lignendeKnap: 'Do you have a similar project?', fuld: 'See the image in full size',
  heroAlt: (foto: boolean) => `${project.name}, ${foto ? 'photo' : 'visualisation'}`, heroTag: (foto: boolean) => (foto ? 'Photo from the delivery' : 'Visualisation'),
  leverede: 'What we delivered', partnere: 'Partners', fra: ['From the', 'delivery.'], fotos: (n: number) => `${n} photos · click for full size`,
  fuldAf: (alt: string) => `See the image in full size: ${alt}`, foto: 'Photo', tegninger: ['Drawings and', 'visualisations.'], tegnesystem: ['From our', 'drawing system.'],
  hint3d: '3D from our own drawing system',
  noteVis: 'Images marked "Visualisation" are 3D from our own drawing system, not photos of the delivery. They are replaced with photos when we have them.',
  noteHero: 'The image at the top is a visualisation from our own drawing system, not a photo of the delivery. It is replaced with photos when we have them.',
  noteAndres: 'We built the fixed furniture. Chairs, tables, tiles and lamps in the pictures are made by others.',
  flere: 'More projects', flereH: ['From tender to', 'installation.'], alleProj: 'All projects →', crumb: 'Projects',
  lb: 'Image in full size', luk: 'Close', forrige: 'Previous image', naeste: 'Next image',
} : {
  alle: '← Alle projekter', lignende: 'Lignende projekt: ', lignendeKnap: 'Har I et lignende projekt?', fuld: 'Se billedet i fuld størrelse',
  heroAlt: (foto: boolean) => `${project.name} — ${foto ? 'foto' : 'visualisering'}`, heroTag: (foto: boolean) => (foto ? 'Foto fra leverancen' : 'Visualisering'),
  leverede: 'Det leverede vi', partnere: 'Samarbejdspartnere', fra: ['Fra', 'leverancen.'], fotos: (n: number) => `${n} fotos · klik for fuld størrelse`,
  fuldAf: (alt: string) => `Se billedet i fuld størrelse: ${alt}`, foto: 'Foto', tegninger: ['Tegninger og', 'visualiseringer.'], tegnesystem: ['Fra', 'tegnesystemet.'],
  hint3d: '3D fra vores eget tegnesystem',
  noteVis: 'Billeder mærket "Visualisering" er 3D fra vores eget tegnesystem — ikke foto af leverancen. De udskiftes med fotos, når vi har dem.',
  noteHero: 'Billedet øverst er en visualisering fra vores eget tegnesystem — ikke foto af leverancen. Det udskiftes med fotos, når vi har dem.',
  noteAndres: 'Vi har bygget inventaret. Stole, borde, fliser og lamper på billederne er andres.',
  flere: 'Flere projekter', flereH: ['Fra udbud til', 'montage.'], alleProj: 'Alle projekter →', crumb: 'Projekter',
  lb: 'Billede i fuld størrelse', luk: 'Luk', forrige: 'Forrige billede', naeste: 'Næste billede',
};

// Lysboksens liste: hero + fotos + andre, i den rækkefølge de står på siden
const lb = [
  ...(project.hero_image_url ? [{ src: project.hero_image_url, alt: heroItem?.alt ?? project.name, kind: heroItem?.kind ?? (heroIsPhoto ? 'foto' : 'visualisering'), caption: heroItem?.caption ?? '' }] : []),
  ...fotos, ...andre,
].map((g) => ({ src: cdn(g.src, 1800), alt: g.alt, label: imgLabel(g.kind, lang), caption: g.caption ?? '' }));

const egen = new URL(`${base}${en ? sagHref('en', project.slug) : `projekter/${project.slug}`}`, site).href;
const alternates = harSagEn(project.slug) ? [
  { hreflang: 'da', href: new URL(`${base}projekter/${project.slug}/`, site).href },
  { hreflang: 'en', href: new URL(base + sagHref('en', project.slug), site).href },
] : [];
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Nem Inventar', item: new URL(base + side(lang, 'forside'), site).href },
    { '@type': 'ListItem', position: 2, name: T.crumb, item: new URL(base + side(lang, 'projekter'), site).href },
    { '@type': 'ListItem', position: 3, name: project.name, item: egen },
  ],
}];
const foraeldet = en && (project as { foraeldet?: boolean }).foraeldet ? `sag/${Astro.props.project.slug}` : undefined;
let lbIndex = 0;
---
<Base lang={lang} title={project.seo_title} description={desc} image={project.hero_image_url ? cdn(project.hero_image_url, 1200) : undefined} jsonLd={jsonLd} alternates={alternates} foraeldet={foraeldet}>
  <section class="cd2"><div class="wrap">
    <div class="crumbrow">
      <a href={`${base}${side(lang, 'projekter')}`} class="crumb">{T.alle}</a>
    </div>
    <div class="cd-head">
      <div>
        <span class="status" style="color:var(--warm)">{project.status_live && <span class="dot"></span>}{project.status_label}</span>
        <h1>{project.name}</h1>
        {project.web_summary && <p class="lead">{project.web_summary}</p>}
      </div>
      <aside class="cd-facts">
        {meta.map((m) => <div class="prow"><span class="pk">{m.k}</span><span class="pv">{m.v}</span></div>)}
        <a href={`${base}${kontaktMedEmne(lang, T.lignende + project.name)}`} class="btn btn-primary">{T.lignendeKnap} <span class="arr">→</span></a>
      </aside>
    </div>

    {project.hero_image_url && (
      <figure class="cd-hero">
        <button class="hero-btn lbtn" data-i={lbIndex++} aria-label={T.fuld}>
          <img src={cdn(project.hero_image_url, 1600)} alt={heroItem?.alt ?? T.heroAlt(heroIsPhoto)} fetchpriority="high" />
        </button>
        <span class="ptag">{T.heroTag(heroIsPhoto)}</span>
        {heroItem?.caption && <figcaption class="img-tag"><b>{project.name}</b>{heroItem.caption}</figcaption>}
      </figure>
    )}

    {numbers.length >= 2 && (
      <div class="talgitter light rv" style={`--n:${numbers.length}`}>
        {numbers.map((x) => <div><b>{x.b}</b><span>{x.t}</span></div>)}
      </div>
    )}

    <div class="cd-body">
      {paragraphs.length > 0 && (
        <div class="prose rv">
          {paragraphs.map((para) => <p>{para}</p>)}
        </div>
      )}
      <aside class="cd-side rv">
        {items.length > 0 && (
          <div class="cd-list">
            <h3>{T.leverede}</h3>
            <ul>{items.map((it) => <li>{it}</li>)}</ul>
          </div>
        )}
      </aside>
    </div>

    {partners && (
      <div class="cd-partner rv">
        <div>
          <span class="label">{partners.title ?? T.partnere}</span>
          <p>{partners.text}</p>
        </div>
        <div class="cp-list">
          {partners.list.map((p) => (
            <a href={p.url} target="_blank" rel="noopener" class="cp"><b>{p.name}</b>{p.role && <span>{p.role}</span>}<em aria-hidden="true">↗</em></a>
          ))}
        </div>
      </div>
    )}

    {fotos.length > 0 && (
      <>
        <div class="cd-gal-head rv">
          <h2>{T.fra[0]} <em>{T.fra[1]}</em></h2>
          <span class="hint">{T.fotos(fotos.length + (heroIsPhoto ? 1 : 0))}</span>
        </div>
        <div class="cd-gallery rv">
          {fotos.map((g, i) => (
            <button class={`gfig lbtn${i % 5 === 0 ? ' big' : ''}`} data-i={lbIndex++} aria-label={T.fuldAf(g.alt)}>
              <img src={cdn(g.src, i % 5 === 0 ? 1200 : 800)} alt={g.alt} loading="lazy" decoding="async" />
              {g.caption && <span class="img-tag"><b>{T.foto}</b>{g.caption}</span>}
            </button>
          ))}
        </div>
      </>
    )}

    {andre.length > 0 && (
      <div class="cd-vis">
        <div class="cd-gal-head rv" style="margin-top:48px">
          {fotos.length || heroIsPhoto ? <h2>{T.tegninger[0]} <em>{T.tegninger[1]}</em></h2> : <h2>{T.tegnesystem[0]} <em>{T.tegnesystem[1]}</em></h2>}
          <span class="hint">{T.hint3d}</span>
        </div>
        <div class="cd-gallery rv">
          {andre.map((g) => (
            <button class={`gfig lbtn${g.kind === 'tegning' ? ' contain' : ''}`} data-i={lbIndex++} aria-label={T.fuldAf(g.alt)}>
              <img src={cdn(g.src, 800)} alt={g.alt} loading="lazy" decoding="async" />
              <span class="ptag">{imgLabel(g.kind, lang)}</span>
            </button>
          ))}
        </div>
        <p class="cd-note rv">{T.noteVis}</p>
      </div>
    )}
    {!andre.length && !heroIsPhoto && (
      <p class="cd-note rv">{T.noteHero}</p>
    )}
    <p class="cd-note rv" style="margin-top:14px">{T.noteAndres}</p>
  </div></section>

  {others.length > 0 && (
    <section class="sec" id="flere"><div class="wrap">
      <div class="sec-head rv">
        <div>
          <span class="label">{T.flere}</span>
          <h2>{T.flereH[0]} <em>{T.flereH[1]}</em></h2>
        </div>
        <a href={`${base}${side(lang, 'projekter')}`} class="ulink">{T.alleProj}</a>
      </div>
      <div class="pgrid three rv">
        {others.map((c) => <ProjectCard c={c} compact lang={lang} />)}
      </div>
    </div></section>
  )}

  <ContactCta subject={T.lignende + project.name} lang={lang} />

  <!-- lysboks -->
  <dialog class="lightbox" id="lb" aria-label={T.lb}>
    <span class="lb-count" id="lbCount"></span>
    <button type="button" class="lb-btn lb-x" id="lbX" aria-label={T.luk}>✕</button>
    <button type="button" class="lb-btn lb-prev" id="lbPrev" aria-label={T.forrige}>←</button>
    <button type="button" class="lb-btn lb-next" id="lbNext" aria-label={T.naeste}>→</button>
    <figure><img id="lbImg" alt="" /><figcaption id="lbCap"></figcaption></figure>
  </dialog>
  <script is:inline type="application/json" id="lb-data" set:html={JSON.stringify(lb)} />
  <script>
    type Item = { src: string; alt: string; label: string; caption: string };
    const dlg = document.getElementById('lb') as HTMLDialogElement | null;
    const data = JSON.parse(document.getElementById('lb-data')?.textContent || '[]') as Item[];
    if (dlg && data.length && typeof dlg.showModal === 'function') {
      const img = document.getElementById('lbImg') as HTMLImageElement, cap = document.getElementById('lbCap')!, cnt = document.getElementById('lbCount')!;
      let i = 0;
      const show = (k: number) => {
        i = (k + data.length) % data.length;
        const it = data[i];
        img.src = it.src; img.alt = it.alt;
        cap.innerHTML = `<b>${it.label}</b>${it.caption || it.alt}`;
        cnt.textContent = `${String(i + 1).padStart(2, '0')} / ${String(data.length).padStart(2, '0')}`;
        const n = data[(i + 1) % data.length]; if (n) { const pre = new Image(); pre.src = n.src; }
      };
      document.querySelectorAll<HTMLButtonElement>('.lbtn').forEach((b) => b.addEventListener('click', () => { show(+(b.dataset.i || 0)); dlg.showModal(); }));
      document.getElementById('lbX')!.addEventListener('click', () => dlg.close());
      document.getElementById('lbPrev')!.addEventListener('click', () => show(i - 1));
      document.getElementById('lbNext')!.addEventListener('click', () => show(i + 1));
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') show(i + 1); if (e.key === 'ArrowLeft') show(i - 1); });
    }
  </script>
</Base>
