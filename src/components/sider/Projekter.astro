---
// Projektoversigten på begge sprog: /projekter og /en/projects/ (ny side 04-10-2026 — plan: Opus på Milots ønske). Alle
// offentlige sager som kort, derunder "Dem, vi har bygget med": arkitekter og entreprenører med navn + link, hvor sagen
// tillader det (show_customer_name / show_architect_name i case_web), ellers som rolle uden navn. Ingen logoer — kun navn
// og link. "Projekter" i topbjælken peger hertil (før: ankeret #projekter på forsiden).
import Base from '../../layouts/Base.astro';
import Ticker from '../Ticker.astro';
import ProjectCard from '../ProjectCard.astro';
import ContactCta from '../ContactCta.astro';
import { getWebCases, type WebCase } from '../../lib/supabase';
import { partnersOf, type Partner } from '../../lib/catalog';
import { side } from '../../lib/stier';
import { sagerPaaEngelsk, sagHref } from '../../lib/engelsk';

interface Props { lang?: 'da' | 'en' }
const { lang = 'da' } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL;
const site = Astro.site!;
const daCases = await getWebCases();
const cases = en ? sagerPaaEngelsk(daCases) : daCases;
const partners = partnersOf(cases);
// sager uden entreprenør overhovedet (aftalen er direkte med bygherren)
const direct = cases.filter((c) => !c.has_contractor);

// Én saglig linje pr. firma: hvad firmaet er, og hvad vi lavede sammen. Holdes her, til der er et felt i data.
const FIRM: Record<string, string> = en ? {
  'Rønnow Arkitekter': 'Architects. The fixed furniture for the school, from lockers to kitchenettes.',
  'WE Architecture': 'Architects. Benches, locker rooms and wash counters for the changing rooms, and a kitchenette.',
  'TRANSFORM': 'Architects. Cloakrooms with seating niches and changing-room furniture.',
  'Kanneworff & Viuff': "Architects. Children's cloakroom units, toilet cubicles and staff furniture.",
  'Ason A/S': 'Contractor. The fixed furniture for the school, in stages as the building went up.',
  'Enemærke & Petersen': 'Contractor. 230 vanity units in compact laminate for 220 homes.',
  'JSP Byg': 'Contractor. Cloakrooms, lockable cabinets and changing-room furniture for the school.',
  'Halbyg': 'Builds sports halls. 43 shoe racks with benches and cladding of columns and a beam.',
} : {
  'Rønnow Arkitekter': 'Arkitektfirma. Skolens faste inventar, fra lockers til tekøkkener.',
  'WE Architecture': 'Arkitektfirma. Bænke, locker-rum og vaskeborde til omklædningen og et tekøkken.',
  'TRANSFORM': 'Arkitektfirma. Garderober med siddenicher og omklædningsmøbler.',
  'Kanneworff & Viuff': 'Arkitektfirma. Børnegarderober, toiletbåse og personaleinventar.',
  'Ason A/S': 'Entreprenørvirksomhed. Skolens faste inventar, i etaper i takt med byggeriet.',
  'Enemærke & Petersen': 'Entreprenørvirksomhed. 230 badeværelsesskabe i kompaktlaminat til 220 boliger.',
  'JSP Byg': 'Entreprenørvirksomhed. Garderober, aflåselige skabe og omklædningsmøbler til skolen.',
  'Halbyg': 'Bygger idrætshaller. 43 skohylder med bænk og beklædning af søjler og bjælke.',
};
const T = en ? {
  arkitekt: 'Architect', entreprenoer: 'Contractor', arkitektLille: 'architect', entreprenoerLille: 'contractor',
  arkitektfirma: 'Architects.', entreprenoerfirma: 'Contractor.',
  sammen: (n: number, navne: string) => `Contractor. ${n === 2 ? 'Two' : n} projects together: ${navne}.`, og: ' and ',
  arkitekter: 'Architects', arkIntro: "We turn the architect's design into a 3D model, workshop drawings and finished furniture.",
  entreprenoerer: 'Contractors', entIntro: 'We supply the fixed furniture to the contractor, from quote and drawings to delivery on site.',
  title: 'Projects | Nem Inventar',
  description: 'Fixed furniture delivered to schools, daycare centres, sports facilities and housing, and the architects and contractors we have built it with.',
  crumb: 'Projects', label: 'Projects', h: ['The projects, and the people we built them', 'with.'],
  lede: 'Fixed furniture for schools, daycare centres, sports facilities and housing, drawn in 3D and built in our own production. Each project has its own page with the delivery, status and photos.',
  send: 'Send drawings or a tender', arkEnt: 'Architects and contractors',
  note: 'Cards marked "Visualisation" show 3D from our own drawing system. Photos are added as the deliveries are photographed.',
  bmLabel: 'Architects and contractors', bmH: ['The people we have built', 'with.'],
  bmLede: 'Each firm is listed with the projects we did together and a link, so you can look it up yourself. We only name a firm when it has given us permission.',
  udenNavn: 'Not named', udenNavnSmaa: 'the name follows once agreed',
  udenArk: 'Architects on projects where we have not yet agreed to name them.', udenEnt: 'Contractors on projects where we have not yet agreed to name them.',
  direkte: (navn: string) => `On ${navn}, the contract is directly with the client.`,
} : {
  arkitekt: 'Arkitekt', entreprenoer: 'Entreprenør', arkitektLille: 'arkitekt', entreprenoerLille: 'entreprenør',
  arkitektfirma: 'Arkitektfirma.', entreprenoerfirma: 'Entreprenørvirksomhed.',
  sammen: (n: number, navne: string) => `Entreprenørvirksomhed. ${n === 2 ? 'To' : n} sager sammen: ${navne}.`, og: ' og ',
  arkitekter: 'Arkitekter', arkIntro: 'Vi gør arkitektens projekt til 3D-model, værkstedstegninger og færdigt inventar.',
  entreprenoerer: 'Entreprenører', entIntro: 'Vi leverer det faste inventar til entreprenøren, fra tilbud og tegninger til levering på pladsen.',
  title: 'Projekter — Nem Inventar',
  description: 'Fast inventar leveret til skoler, daginstitutioner, idrætsanlæg og boliger — og de arkitekter og entreprenører, vi har bygget sammen med.',
  crumb: 'Projekter', label: 'Projekter', h: ['Sagerne — og dem, vi har bygget dem', 'med.'],
  lede: 'Fast inventar til skoler, daginstitutioner, idrætsanlæg og boliger, tegnet i 3D og bygget i vores egen produktion. Hver sag har sin egen side med leverance, status og billeder.',
  send: 'Send tegninger eller udbud', arkEnt: 'Arkitekter og entreprenører',
  note: 'Kort mærket "Visualisering" viser 3D fra vores eget tegnesystem. Fotos kommer på, efterhånden som leverancerne bliver fotograferet.',
  bmLabel: 'Arkitekter og entreprenører', bmH: ['Dem, vi har bygget', 'med.'],
  bmLede: 'Hvert firma står med de sager, vi har lavet sammen, og et link, så I selv kan slå det op. Vi nævner kun et firma ved navn, når det har givet lov.',
  udenNavn: 'Uden navn', udenNavnSmaa: 'navnet følger efter aftale',
  udenArk: 'Arkitektfirmaer på sager, hvor vi endnu ikke har aftalt at nævne navnet.', udenEnt: 'Entreprenører på sager, hvor vi endnu ikke har aftalt at nævne navnet.',
  direkte: (navn: string) => `På ${navn} er aftalen direkte med bygherren.`,
};
const firmLine = (p: Partner, kind: 'architects' | 'contractors') =>
  p.name === 'Ason A/S' && p.cases.length > 1
    ? T.sammen(p.cases.length, p.cases.map((c) => c.name).join(T.og))
    : FIRM[p.name] ?? (kind === 'architects' ? T.arkitektfirma : T.entreprenoerfirma);
const domain = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const roleOf = (kind: 'architects' | 'contractors') => (kind === 'architects' ? T.arkitekt : T.entreprenoer);

// Båndet øverst viser firmaerne, ikke tallene (Milot 04-10): navn · rolle · sagerne. Kun navne, der må vises.
const band = [
  ...partners.architects.named.map((p) => ({ b: p.name, t: T.arkitektLille, c: p.cases.map((c) => c.name).join(' · ') })),
  ...partners.contractors.named.map((p) => ({ b: p.name, t: T.entreprenoerLille, c: p.cases.map((c) => c.name).join(' · ') })),
];

const GROUPS: { kind: 'architects' | 'contractors'; label: string; intro: string; list: { named: Partner[]; unnamed: WebCase[] } }[] = [
  { kind: 'architects', label: T.arkitekter, intro: T.arkIntro, list: partners.architects },
  { kind: 'contractors', label: T.entreprenoerer, intro: T.entIntro, list: partners.contractors },
];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Nem Inventar', item: new URL(base + side(lang, 'forside'), site).href },
    { '@type': 'ListItem', position: 2, name: T.crumb, item: new URL(base + side(lang, 'projekter'), site).href },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: T.crumb, itemListElement: cases.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, url: new URL(`${base}${sagHref(lang, c.slug)}`, site).href })) },
];
const alternates = [
  { hreflang: 'da', href: new URL(base + 'projekter/', site).href },
  { hreflang: 'en', href: new URL(base + 'en/projects/', site).href },
];
---
<Base lang={lang} title={T.title} description={T.description} jsonLd={jsonLd} alternates={alternates}>

  <!-- ============ TOPPEN ============ -->
  <header class="pj-top" id="top"><div class="wrap">
    <span class="label">{T.label}</span>
    <h1>{T.h[0]} <em>{T.h[1]}</em></h1>
    <p class="lede">{T.lede}</p>
    <div class="pj-btns">
      <a href={`${base}${side(lang, 'kontakt')}`} class="btn btn-primary">{T.send} <span class="arr">→</span></a>
      <a href="#bygget-med" class="btn btn-ghost">{T.arkEnt} <span class="arr">↓</span></a>
    </div>
  </div></header>

  <div class="ticker-names"><Ticker cases={[]} extra={band} lang={lang} /></div>

  <!-- ============ ALLE SAGER ============ -->
  <section class="sec" id="alle"><div class="wrap">
    <div class="pgrid rv">
      {cases.map((c) => <ProjectCard c={c} lang={lang} />)}
    </div>
    <p class="pj-note rv">{T.note}</p>
  </div></section>

  <!-- ============ DEM, VI HAR BYGGET MED ============ -->
  <section class="bm" id="bygget-med"><div class="wrap">
    <div class="sec-head rv">
      <div>
        <span class="label">{T.bmLabel}</span>
        <h2>{T.bmH[0]} <em>{T.bmH[1]}</em></h2>
        <p class="lede">{T.bmLede}</p>
      </div>
    </div>

    {GROUPS.map((g) => (
      <div class="bm-group rv">
        <div class="bm-head">
          <span class="label">{g.label}</span>
          <p>{g.intro}</p>
        </div>
        {g.list.named.map((p) => (
          <div class="bm-row">
            <div class="bm-name">
              <b>{p.name}</b>
              {p.url && <a href={p.url} target="_blank" rel="noopener">{domain(p.url)} ↗</a>}
            </div>
            <p class="bm-line">{firmLine(p, g.kind)}</p>
            <div class="bm-cases">
              {p.cases.map((c) => <a href={`${base}${sagHref(lang, c.slug)}`}><span>{roleOf(g.kind)}</span>{c.name} →</a>)}
            </div>
          </div>
        ))}
        {g.list.unnamed.length > 0 && (
          <div class="bm-row bm-unnamed">
            <div class="bm-name"><b>{T.udenNavn}</b><small>{T.udenNavnSmaa}</small></div>
            <p class="bm-line">{g.kind === 'architects' ? T.udenArk : T.udenEnt}</p>
            <div class="bm-cases">
              {g.list.unnamed.map((c) => <a href={`${base}${sagHref(lang, c.slug)}`}><span>{roleOf(g.kind)}</span>{c.name} →</a>)}
            </div>
          </div>
        )}
        {g.kind === 'contractors' && direct.length > 0 && (
          <p class="bm-direct">{direct.map((c) => T.direkte(c.name)).join(' ')}</p>
        )}
      </div>
    ))}
  </div></section>

  <ContactCta lang={lang} />

  <style>
    .pj-top{padding:64px 0 36px}
    .pj-top h1{font-size:clamp(38px,5.2vw,72px);line-height:1.02;letter-spacing:-.02em;margin-top:22px;max-width:14em}
    .pj-top .lede{font-size:clamp(17px,1.5vw,21px);line-height:1.55;color:var(--ink);margin-top:22px;max-width:36em}
    .pj-btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
    .pj-note{margin-top:22px;font-size:13.5px;color:var(--muted)}
    /* dem, vi har bygget med: rækker, ikke fliser */
    .bm{background:var(--soft);padding:88px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
    .bm-group{margin-top:44px}
    .bm-head{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:32px;align-items:baseline;padding-bottom:14px;border-bottom:1px solid var(--line)}
    .bm-head p{font-size:15px;color:var(--muted);margin:0}
    .bm-row{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,5fr) minmax(0,3fr);gap:32px;padding:24px 0;border-bottom:1px solid var(--line);align-items:start}
    .bm-name b{display:block;font-family:'Archivo',sans-serif;font-weight:600;font-size:24px;line-height:1.15;letter-spacing:-.01em}
    .bm-name a{display:inline-block;margin-top:6px;font-size:14px;color:var(--ink);text-decoration:underline;text-decoration-color:var(--warm);text-underline-offset:3px}
    .bm-name a:hover{color:var(--warm)}
    .bm-name small{display:block;margin-top:6px;font-size:13px;color:var(--muted)}
    .bm-line{font-size:16px;color:var(--muted);line-height:1.6;margin:4px 0 0}
    .bm-cases{display:grid;gap:8px}
    .bm-cases a{display:flex;gap:10px;align-items:baseline;min-height:44px;padding:10px 14px;border:1px solid var(--line);border-radius:12px;background:#fff;font-size:14.5px;font-weight:600;color:var(--ink);text-decoration:none;transition:border-color .2s,transform .35s cubic-bezier(.2,.7,.2,1)}
    .bm-cases a span{font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--warm);font-weight:700}
    .bm-cases a:hover{border-color:var(--warm);transform:translateY(-2px)}
    .bm-unnamed .bm-name b{color:var(--muted);font-weight:500}
    .bm-direct{margin-top:14px;font-size:14px;color:var(--muted)}
    @media(max-width:880px){
      .pj-top{padding:40px 0 24px}
      .pj-top h1{font-size:40px}
      .pj-btns .btn{width:100%;justify-content:center}
      .bm{padding:56px 0}
      .bm-head,.bm-row{grid-template-columns:1fr;gap:12px}
      .bm-row{padding:20px 0}
    }
  </style>
</Base>
