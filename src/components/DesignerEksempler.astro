---
// Kort med eksempler fra designeren: alle på /design-det-selv/, udvalgte på landingssider (landing_web.designer_eksempler).
// Hvert kort åbner designeren med præcis den konfiguration (permalinket ?t=), og billedet er designerens egen 3D af samme
// konfiguration (scripts/designer_eksempler.py). Et klik tælles i Plausible som "Eksempel valgt" (eksempel, produkt, side) —
// sammen med designerens egen tunnel (fn_plausible_tunnel) viser det, hvad folk vil have, og hvilken side de kom fra.
import EKS from '../data/designer-eksempler.json';
import { eksempelLink } from '../lib/forside';

interface Props { ids?: string[]; side?: string; overskrift?: 'h2' | 'h3' }
const { ids, side, overskrift = 'h2' } = Astro.props;
const H = overskrift;
const base = import.meta.env.BASE_URL;
const NAVN: Record<string, string> = { hoejskab: 'Højskab', baenk: 'Bænk', locker: 'Lockers', akustik: 'Akustik' };
// Udvalgte i den rækkefølge, siden angiver (redaktionel); ukendte id'er springes over.
const liste = ids ? ids.map((id) => EKS.find((e) => e.id === id)).filter((e): e is (typeof EKS)[number] => Boolean(e)) : EKS;
const billede = (id: string) => `${base}billeder/designer-eksempler/${id}.jpg`;
---
<div class="dds-grid">
  {liste.map((e) => (
    <article class="dds-kort">
      <a class="dds-img" href={eksempelLink(e)} data-eks={e.id} data-produkt={e.produkt} data-side={side} tabindex="-1" aria-hidden="true">
        <img src={billede(e.id)} alt="" width="1200" height="800" loading="lazy" decoding="async" />
      </a>
      <span class="dds-tag">{NAVN[e.produkt]}</span>
      <H>{e.titel}</H>
      <p>{e.tekst}</p>
      <a class="dds-cta" href={eksempelLink(e)} data-eks={e.id} data-produkt={e.produkt} data-side={side}>Byg videre på den <span aria-hidden="true">→</span></a>
    </article>
  ))}
</div>

<style>
  .dds-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:34px 26px;margin-top:34px}
  .dds-kort{display:flex;flex-direction:column;gap:8px}
  .dds-img{display:block;border-radius:var(--radius);overflow:hidden;background:var(--soft);aspect-ratio:3/2}
  .dds-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s ease}
  .dds-img:hover img{transform:scale(1.02)}
  .dds-tag{margin-top:6px;font-size:12.5px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--warm)}
  .dds-kort :is(h2,h3){font-size:21px;line-height:1.25;margin:0}
  .dds-kort p{margin:0;color:var(--muted);font-size:15px;line-height:1.5}
  .dds-cta{margin-top:auto;padding-top:6px;font-weight:600;color:var(--ink);text-decoration-color:var(--warm-soft);text-underline-offset:3px}
</style>
<script>
  // et klik på et eksempel tælles (Plausible, ingen persondata) — hvad folk vil bygge videre på, og fra hvilken side.
  // Gælder alle links med data-eks på siden, også landingssidens "Byg den selv i designeren".
  document.querySelectorAll<HTMLAnchorElement>('a[data-eks]').forEach((a) => a.addEventListener('click', () => {
    const props: Record<string, string> = { eksempel: a.dataset.eks ?? '', produkt: a.dataset.produkt ?? '' };
    if (a.dataset.side) props.side = a.dataset.side;
    (window as unknown as { plausible?: (n: string, o: object) => void }).plausible?.('Eksempel valgt', { props });
  }));
</script>
