---
// Kort for en type i kataloget — samme kort på forsiden, landingssiderne og produktsiderne ("Andre typer"), på begge sprog.
import { cdn } from '../lib/img';
interface Props { name: string; href: string; img: string; pos?: string; tag: string; fam: string; desc: string; dataFam?: string; lang?: 'da' | 'en' }
const { name, href, img, pos = '50% 60%', tag, fam, desc, dataFam, lang = 'da' } = Astro.props;
const en = lang === 'en';
---
<article class="tcard" data-fam={dataFam}>
  <a class="ph" href={href} aria-label={name}>
    {img && <img src={cdn(img, 800)} alt={name} style={`--pos:${pos}`} loading="lazy" decoding="async" />}
    <span class="ptag">{tag}</span>
  </a>
  <div class="body">
    <span class="kicker">{fam}</span>
    <h3><a href={href}>{name}</a></h3>
    <p class="desc">{desc}</p>
    <div class="tfoot">
      {en ? <span class="made"><b>Made to measure</b> · priced from the drawings</span> : <span class="made"><b>Til mål</b> · pris efter opmåling</span>}
      <a href={href} class="order">{en ? 'See more' : 'Se mere'} <span class="arr">→</span></a>
    </div>
  </div>
</article>
