---
// Projektkort med data i tabelform og "Se projektet" (Milot 03-10-2026). Bruges på forsiden, landingssiderne
// og nederst på projektsiderne. `compact` = tre pr. række (kortere resumé).
import type { WebCase } from '../lib/supabase';
import { cdn } from '../lib/img';
import { caseMeta, isPhoto } from '../lib/catalog';
// lang 'en': den engelske forside (sagen kommer på engelsk fra lib/engelsk.ts; projektsiden er på dansk).
interface Props { c: WebCase; compact?: boolean; lang?: 'da' | 'en' }
const { c, compact = false, lang = 'da' } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}projekter/${c.slug}`;
const en = lang === 'en';
---
<article class={`pcard${compact ? ' compact' : ''}`}>
  <a class="ph" href={href} aria-label={c.name}>
    {c.hero_image_url && <img src={cdn(c.hero_image_url, compact ? 800 : 1000)} alt={c.name} loading="lazy" decoding="async" />}
    <span class="ptag">{isPhoto(c.hero_image_url) ? (en ? 'Photo from the delivery' : 'Foto fra leverancen') : (en ? 'Visualisation' : 'Visualisering')}</span>
  </a>
  <div class="body">
    <span class="status">{c.status_live && <span class="dot"></span>}{c.status_label}</span>
    <h3><a href={href}>{c.name}</a></h3>
    <p class="desc">{c.web_summary}</p>
    <div class="pmeta">
      {caseMeta(c, lang).map((m) => <div class="prow"><span class="pk">{m.k}</span><span class="pv">{m.v}</span></div>)}
    </div>
    <div class="pbtn"><a href={href} class="btn btn-primary">{en ? 'See the project' : 'Se projektet'} <span class="arr">→</span></a></div>
  </div>
</article>
