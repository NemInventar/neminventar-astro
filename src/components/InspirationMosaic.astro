---
// Inspiration (forside v3): de bedste renders som varianter — "Set i 3D, før det bygges." Hver flise er en variant
// (lib/varianter.ts): billedet åbner typesiden med kuløren valgt (#v-<kulør>), og knappen åbner designeren (når den er
// offentlig og typen findes der) eller "Send os materialet" med varianten udfyldt (data-variant, HeroPaths' script).
// Uden JS fører knappen til kontaktsiden med ?v=. Udvalget og teksterne står i src/lib/forside.ts (INSPIRATION).
// Billedteksterne siger, hvad renderen viser — ikke hvilket projekt den er fra.
import type { WebProduct, WebColor } from '../lib/supabase';
import { cdn } from '../lib/img';
import { INSPIRATION, DESIGNER_URL, DESIGNER_AF } from '../lib/forside';
import { varianterAf, prisHref, variantTilbud } from '../lib/varianter';
interface Props { products: WebProduct[]; colors: WebColor[] }
const { products, colors } = Astro.props;
const base = import.meta.env.BASE_URL;
const tiles = INSPIRATION.map((t) => {
  const p = products.find((x) => x.slug === t.slug);
  const v = p ? varianterAf(p, colors).find((x) => x.kuloer === t.kuloer) : undefined;
  if (!p || !v) return null;
  const d = DESIGNER_URL ? DESIGNER_AF[p.slug] : undefined;
  return { ...t, img: v.img, href: `${base}produkter/${p.slug}#${v.id}`,
    cta: d ? { l: 'Åbn denne i designeren', href: `${DESIGNER_URL}?p=${d}`, variant: undefined }
      : { l: 'Få pris på denne', href: prisHref(base, v), variant: JSON.stringify(variantTilbud(v)) } };
}).filter((x): x is NonNullable<typeof x> => !!x);
---
<div class="mos">
  {tiles.map((t) => (
    <figure class={`mt w${t.w}`}>
      <a class="mt-img" href={t.href} aria-label={`${t.titel}, ${t.variant}`}><img src={cdn(t.img, t.w === 8 ? 1400 : 800)} alt={`${t.titel}, ${t.variant.toLowerCase()}`} loading="lazy" decoding="async" /></a>
      <span class="tagv">Visualisering</span>
      <figcaption>
        <div><b>{t.titel}</b><span>{t.variant}</span></div>
        <a class="mt-cta" href={t.cta.href} data-variant={t.cta.variant}>{t.cta.l} <span aria-hidden="true">→</span></a>
      </figcaption>
    </figure>
  ))}
</div>
<style>
  .mos{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px}
  .mt{position:relative;margin:0;border-radius:18px;overflow:hidden;background:var(--soft)}
  .mt.w8{grid-column:span 8;aspect-ratio:1200/655}
  .mt.w4{grid-column:span 4;aspect-ratio:600/655}
  .mt-img{position:absolute;inset:0;display:block}
  .mt-img img{width:100%;height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.2,.7,.2,1)}
  .mt:hover .mt-img img{transform:scale(1.035)}
  .tagv{position:absolute;left:12px;top:12px;font-size:11px;font-weight:600;letter-spacing:.06em;background:rgba(250,248,243,.92);color:var(--ink);border-radius:999px;padding:4px 10px;pointer-events:none}
  figcaption{position:absolute;left:0;right:0;bottom:0;padding:40px 16px 14px;background:linear-gradient(180deg,rgba(23,20,14,0),rgba(23,20,14,.72));color:#F7F2E8;display:flex;justify-content:space-between;align-items:flex-end;gap:10px;flex-wrap:wrap;pointer-events:none}
  figcaption b{font-family:'Archivo',sans-serif;font-size:17px;font-weight:700;display:block}
  figcaption span{font-size:13px;color:#E3D9C7}
  .mt-cta{pointer-events:auto;border-radius:999px;padding:7px 12px;font-size:12.5px;font-weight:600;background:rgba(250,248,243,.95);color:var(--ink);text-decoration:none;opacity:0;transform:translateY(6px);transition:opacity .25s,transform .25s}
  .mt:hover .mt-cta,.mt:focus-within .mt-cta{opacity:1;transform:none}
  @media (hover:none){.mt-cta{opacity:1;transform:none}}
  @media (max-width:900px){
    .mos{grid-template-columns:1fr 1fr;gap:10px}
    .mt.w8{grid-column:1/-1}
    .mt.w4{grid-column:span 1;aspect-ratio:1/1}
    figcaption{padding:28px 10px 10px}
    figcaption b{font-size:14px}
    .mt.w4 .mt-cta{display:none}
  }
  @media (prefers-reduced-motion:reduce){.mt-img img,.mt-cta{transition:none}}
</style>
