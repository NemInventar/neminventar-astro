---
// Delt navigation. Anker-links peger på forsidens sektioner og er base-bevidste
// (import.meta.env.BASE_URL), så de virker både på custom domain ('/') og GitHub
// projekt-side ('/repo/').
// Telefonen står synligt i headeren (også på mobil, hvor et tryk ringer op) — Joachim 01-10-2026.
import { PHONE, PHONE_TEL, LINKEDIN } from '../lib/contact';
const base = import.meta.env.BASE_URL; // slutter med '/'
---
<nav><div class="wrap nav-in">
  <a href={base} class="brand">NEM<b>·</b>INVENTAR</a>
  <div class="nav-links">
    <a href={`${base}#projekter`}>Projekter</a>
    <a href={`${base}#katalog`}>Inventar</a>
    <a href={`${base}#designer`}>Designeren<span class="soon">snart</span></a>
    <a href={`${base}#saadan`}>Sådan arbejder vi</a>
    <a href={`${base}om-os`}>Om os</a>
    <a href={`${base}en/`} hreflang="en" lang="en" title="English">EN</a>
    <a href={LINKEDIN} class="nav-icon" target="_blank" rel="noopener" aria-label="Nem Inventar på LinkedIn" title="LinkedIn">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
    </a>
    <a href={`tel:${PHONE_TEL}`} class="nav-tel" aria-label={`Ring til os på ${PHONE}`}>
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
      <span><span class="cc">+45 </span>{PHONE.replace('+45 ', '')}</span>
    </a>
    <a href={`${base}kontakt`} class="nav-cta">Få en pris</a>
  </div>
</div></nav>

<style>
  /* "snart"-mærke ved designeren, indtil den åbner */
  .soon{display:inline-block;margin-left:6px;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--warm);border:1px solid rgba(162,101,42,.4);border-radius:999px;padding:2px 7px;vertical-align:middle}
</style>
