---
// Delt footer i fire spalter: hvem vi er · inventar og materialer · hvem vi leverer til · firmaet.
// Landingssiderne linkes fra hver side (intern linkstruktur) — grupperet efter type i stedet for én lang linje.
import { getWebLandingPages } from '../lib/supabase';
import { guidesFor, guidePath } from '../lib/guides-i18n';
import { PHONE, PHONE_TEL, LINKEDIN, FACEBOOK, MIN_SIDE, MIN_SIDE_EN } from '../lib/contact';
// Min side (12-11-2026, Fable runde 3 afsnit b) — samme props som Nav:
//   origin     = 'https://neminventar.dk' gør alle interne links til fulde adresser til sitet (standard '': som før).
//   visMinSide = "Min side" øverst i spalten "Nem Inventar" (engelsk: "My account"). Tysk har ingen Min side.
// konto.neminventar.dk bruger KontoFooter.astro, ikke denne: footeren her henter landingssiderne fra ERP ved build.
const { lang = 'da', origin = '', visMinSide = false } = Astro.props as { lang?: 'da' | 'en' | 'de'; origin?: string; visMinSide?: boolean };
const base = origin ? `${origin.replace(/\/+$/, '')}/` : import.meta.env.BASE_URL; // slutter med '/'
// En adresse på sitet. Med origin får en side afsluttende skråstreg her, for skraastreg.mjs retter kun links til sider i eget dist.
const u = (p = '') => (origin && p && !/[#?.]/.test(p) && !p.endsWith('/') ? `${base}${p}/` : `${base}${p}`);
const minSide = !visMinSide || lang === 'de' ? null : lang === 'en' ? { href: MIN_SIDE_EN, t: 'My account' } : { href: MIN_SIDE, t: 'Min side' };
const landing = await getWebLandingPages();
const emner = landing.filter((l) => l.kind === 'emne');
const segmenter = landing.filter((l) => l.kind === 'segment');
const guides = landing.filter((l) => l.kind === 'guide');
const year = new Date().getFullYear();
const guidesEn = guidesFor('en', landing);
const guidesDe = guidesFor('de', landing);
// Engelsk udgave (/en/): kun de engelske sider + vej tilbage til den danske. Landingssiderne er på dansk og linkes ikke.
// Tysk light-udgave (/de/): landingssiden, Impressum og Datenschutz (krævet af tysk ret).
---
{lang === 'de' ? (
<footer><div class="wrap">
  <div class="foot2">
    <div class="foot-brand">
      <div class="brand">NEM<b style="color:var(--warm)">·</b>INVENTAR</div>
      <p>Festeinbauten nach Maß für Schulen, Sporthallen und Wohnungsbau, im 3D-Modell geplant und in eigener Fertigung gebaut.</p>
      <p class="foot-tel"><a href={`tel:${PHONE_TEL}`}>{PHONE}</a></p>
      <p><a href="mailto:tilbud@neminventar.dk">tilbud@neminventar.dk</a></p>
    </div>
    <div>
      <h4>Auf Deutsch</h4>
      <ul>
        <li><a href={u('de/')}>Spind mit Sitzbank</a></li>
        <li><a href={u('de/#kontakt')}>Anfrage senden</a></li>
      </ul>
      <h4 style="margin-top:26px">Ratgeber</h4>
      <ul>
        {guidesDe.map((g) => <li><a href={u(guidePath('de', g.slug))}>{g.nav_label}</a></li>)}
      </ul>
    </div>
    <div>
      <h4>Rechtliches</h4>
      <ul>
        <li><a href={u('de/impressum/')}>Impressum</a></li>
        <li><a href={u('de/datenschutz/')}>Datenschutz</a></li>
      </ul>
    </div>
    <div>
      <h4>Andere Sprachen</h4>
      <ul>
        <li><a href={u()} hreflang="da" lang="da">Dansk</a></li>
        <li><a href={u('en/')} hreflang="en" lang="en">English</a></li>
        <li><a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href={FACEBOOK} target="_blank" rel="noopener">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="foot-bottom">
    <span>© {year} Nem Inventar ApS · USt-IdNr. DK45085473</span>
    <span>Mågevej 73, st. tv. · 2400 Kopenhagen NV · Dänemark</span>
  </div>
</div></footer>
) : lang === 'en' ? (
<footer><div class="wrap">
  <div class="foot2">
    <div class="foot-brand">
      <div class="brand">NEM<b style="color:var(--warm)">·</b>INVENTAR</div>
      <p>Built-in joinery and fixed furniture for construction, modelled in 3D and built in our own production. Single pieces and whole projects.</p>
      <p class="foot-tel"><a href={`tel:${PHONE_TEL}`}>{PHONE}</a></p>
      <p><a href="mailto:tilbud@neminventar.dk">tilbud@neminventar.dk</a></p>
    </div>
    <div>
      <h4>In English</h4>
      <ul>
        <li><a href={u('en/')}>Nem Inventar</a></li>
        <li><a href={u('en/products/')}>Products</a></li>
        <li><a href={u('en/lockers/')}>Lockers made to measure</a></li>
        <li><a href={u('en/lockers-with-bench/')}>Lockers with bench</a></li>
        <li><a href={u('en/wardrobes/')}>Wardrobes made to measure</a></li>
        <li><a href={u('en/contact/')}>Contact</a></li>
      </ul>
      <h4 style="margin-top:26px">Guides</h4>
      <ul>
        {guidesEn.map((g) => <li><a href={u(guidePath('en', g.slug))}>{g.nav_label}</a></li>)}
      </ul>
    </div>
    <div>
      <h4>På dansk</h4>
      <ul>
        <li><a href={u()} hreflang="da" lang="da">Forside</a></li>
        <li><a href={u('projekter')} hreflang="da" lang="da">Projekter</a></li>
        <li><a href={u('privatlivspolitik')} hreflang="da" lang="da">Privatlivspolitik</a></li>
      </ul>
    </div>
    <div>
      <h4>Nem Inventar</h4>
      <ul>{minSide && <li><a href={minSide.href}>{minSide.t}</a></li>}
        <li><a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href={FACEBOOK} target="_blank" rel="noopener">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="foot-bottom">
    <span>© {year} Nem Inventar ApS · VAT DK45085473</span>
    <span>Mågevej 73, st. tv. · 2400 Copenhagen NV · Denmark</span>
  </div>
</div></footer>
) : (
<footer><div class="wrap">
  <div class="foot2">
    <div class="foot-brand">
      <div class="brand">NEM<b style="color:var(--warm)">·</b>INVENTAR</div>
      <p>Fast inventar til byggeri — tegnet i 3D, bygget i vores egenproduktion. Enkelte møbler fra kataloget og hele projekter. Vi leverer også til private.</p>
      <p class="foot-tel"><a href={`tel:${PHONE_TEL}`}>{PHONE}</a></p>
      <p><a href="mailto:kontakt@neminventar.dk">kontakt@neminventar.dk</a> · <a href="mailto:tilbud@neminventar.dk">tilbud@neminventar.dk</a></p>
    </div>
    <div>
      <h4>Inventar og materialer</h4>
      <ul class={emner.length > 9 ? 'cols2' : undefined}>
        {emner.map((l) => <li><a href={u(l.slug)}>{l.nav_label}</a></li>)}
      </ul>
    </div>
    <div>
      <h4>Til</h4>
      <ul>
        {segmenter.map((l) => <li><a href={u(l.slug)}>{l.nav_label}</a></li>)}
      </ul>
      {guides.length > 0 && (
        <>
          <h4 style="margin-top:26px">Guides</h4>
          <ul>{guides.map((l) => <li><a href={u(l.slug)}>{l.nav_label}</a></li>)}</ul>
        </>
      )}
    </div>
    <div>
      <h4>Nem Inventar</h4>
      <ul>{minSide && <li><a href={minSide.href}>{minSide.t}</a></li>}
        <li><a href={u('projekter')}>Projekter</a></li>
        <li><a href={u('inventar')}>Inventar</a></li>
        <li><a href={u('om-os')}>Om os</a></li>
        <li><a href={u('kontakt')}>Kontakt</a></li>
        <li><a href={u('nem-inventar-brochure.pdf')}>Brochure (PDF)</a></li>
        <li><a href={u('en/')} hreflang="en" lang="en">In English</a></li>
        <li><a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href={FACEBOOK} target="_blank" rel="noopener">Facebook</a></li>
      </ul>
      <h4 style="margin-top:26px">Det juridiske</h4>
      <ul>
        <li><a href={u('handelsbetingelser')}>Handelsbetingelser for private</a></li>
        <li><a href={u('privatlivspolitik')}>Privatlivspolitik</a></li>
        <li><a href={u('cookiepolitik')}>Cookiepolitik</a></li>
      </ul>
    </div>
  </div>
  <div class="foot-bottom">
    <span>© {year} Nem Inventar ApS · CVR 45085473</span>
    <span>Mågevej 73, st. tv. · 2400 København NV</span>
  </div>
</div></footer>
)}
