---
// Self-hostede fonts (Fontsource) — intet Google-CDN-kald, hurtigere render + ingen IP til tredjepart.
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/400-italic.css';
import '@fontsource/archivo/600-italic.css';
import '../styles/site.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { LINKEDIN } from '../lib/contact';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, unknown>[]; // side-specifik struktureret data (FAQ, brødkrummer …)
  lang?: 'da' | 'en';
  // Sprogversioner af samme side (hreflang). Sættes kun på sider, der findes på begge sprog.
  alternates?: { hreflang: string; href: string }[];
}

const { title, description, image, jsonLd = [], lang = 'da', alternates = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ?? new URL(import.meta.env.BASE_URL + 'og-default.png', Astro.site).href;
const base = import.meta.env.BASE_URL;
const home = new URL(base, Astro.site).href;

// Hvem vi er — på hver side, så søgemaskiner og AI-assistenter kan læse det maskinelt.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': home + '#virksomhed',
  name: 'Nem Inventar ApS',
  url: home,
  logo: new URL(base + 'favicon.svg', Astro.site).href,
  image: new URL(base + 'og-default.png', Astro.site).href,
  description:
    'Fast inventar til byggeri — skoler, daginstitutioner, idrætshaller og erhverv. Krydsfiner, kompaktlaminat, linoleum og massivt træ, bygget til mål i egen produktion.',
  telephone: '+45 42 42 26 84',
  email: 'kontakt@neminventar.dk',
  vatID: 'DK45085473',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Mågevej 73, st. tv.',
    postalCode: '2400',
    addressLocality: 'København NV',
    addressCountry: 'DK',
  },
  areaServed: { '@type': 'Country', name: 'Danmark' },
  // Samme virksomhed andre steder — binder profilerne sammen til én enhed for Google og AI-søgning.
  // Tilføj Krak, Proff og Bing Places her, når de har en fast profil-URL.
  sameAs: ['https://g.page/r/CZTJypcXhpHcEBM', LINKEDIN],
  hasMap: 'https://g.page/r/CZTJypcXhpHcEBM',
  knowsAbout: [
    'Krydsfiner-inventar', 'Kompaktlaminat', 'Toiletbåse', 'Garderober', 'Troldegarderober',
    'Lockers', 'Omklædningsbænke', 'Tekøkkener', 'Køkkenøer', 'Siddenicher', 'Akustikpaneler',
    'Glastavler', 'Skoleinventar', 'Inventar til daginstitutioner', 'Inventar til idrætshaller',
  ],
};
const ld = [organization, ...jsonLd];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <meta name="generator" content={Astro.generator} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Nem Inventar" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'da_DK'} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Afsnit, der glider ind ved scroll (.rv), er kun skjult når JS kører — crawlere og no-JS ser alt -->
  <script is:inline>document.documentElement.classList.add('js');</script>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="apple-touch-icon" href={`${base}favicon.svg`} />
  <meta name="theme-color" content="#17140E" />
  {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

  <!-- Besøgsstatistik uden cookies (Plausible, EU). Tæller sider, kilder (Google, Bing, chatgpt.com) og
       leads: klik på mail- og telefonlinks + download af brochuren. Ingen personoplysninger, intet banner. -->
  <!-- Site-specifikt script fra Plausible-kontoen (js@). Downloads/udgående links slås til i Plausible → Site settings. -->
  <script async src="https://plausible.io/js/pa-HNaluSTt8ee5v0U7h3J8z.js"></script>
  <script is:inline>
    window.plausible = window.plausible || function () { (plausible.q = plausible.q || []).push(arguments); }, plausible.init = plausible.init || function (i) { plausible.o = i || {}; };
    plausible.init();
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href^="mailto:"], a[href^="tel:"]');
      if (!a) return;
      var mail = a.getAttribute('href').indexOf('mailto:') === 0;
      window.plausible(mail ? 'Mail' : 'Telefon', { props: { side: location.pathname } });
    });
  </script>
</head>
<body>
  <Nav />
  <slot />
  <Footer />
  <script>
    // ---------- ankre fra andre sider (fx "Inventar" → /#katalog) ----------
    // Browseren ruller til ankeret, før skrifter og billeder er færdige; når indholdet ovenfor derefter vokser, ender
    // ankeret ude af syne (målt 04-10-2026). Så rulles der igen, uden glid, når siden og skrifterne er klar — og en gang til kort efter.
    (() => {
      const hash = location.hash;
      if (!hash || hash.length < 2) return;
      const target = () => document.getElementById(decodeURIComponent(hash.slice(1)));
      const jump = () => { const el = target(); if (!el) return; const h = document.documentElement; const prev = h.style.scrollBehavior; h.style.scrollBehavior = 'auto'; el.scrollIntoView({ block: 'start' }); h.style.scrollBehavior = prev; };
      const run = () => { jump(); setTimeout(jump, 400); setTimeout(jump, 1200); };
      if (document.readyState === 'complete') run(); else window.addEventListener('load', run, { once: true });
      if ('fonts' in document) (document as any).fonts.ready.then(jump);
    })();
    // ---------- afsnit glider ind, når de rulles frem ----------
    (() => {
      const els = document.querySelectorAll('.rv');
      if (!els.length) return;
      if (!('IntersectionObserver' in window)) { els.forEach((el) => el.classList.add('in')); return; }
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      els.forEach((el) => io.observe(el));
    })();
    // ---------- video spiller kun i synsfeltet; data-start springer optagelsens indledning over ----------
    // Der spoles først ved afspilning: sættes currentTime før første play, smider browseren plakaten og viser et tomt felt.
    (() => {
      const vids = document.querySelectorAll<HTMLVideoElement>('video[data-inview]');
      if (!vids.length) return;
      const vio = new IntersectionObserver((es) => es.forEach((e) => {
        const v = e.target as HTMLVideoElement, start = +(v.dataset.start || 0);
        if (e.isIntersecting) { if (start && v.currentTime < start) v.currentTime = start; v.play().catch(() => {}); }
        else v.pause();
      }), { threshold: 0.25 });
      vids.forEach((v) => {
        const start = +(v.dataset.start || 0);
        if (start) v.addEventListener('ended', () => { v.currentTime = start; v.play().catch(() => {}); });
        else v.loop = true;
        vio.observe(v);
      });
    })();
  </script>
</body>
</html>
