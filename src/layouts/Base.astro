---
// Self-hostede fonts (Fontsource) — intet Google-CDN-kald, hurtigere render + ingen IP til tredjepart.
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/400-italic.css';
import '@fontsource/archivo/600-italic.css';
import '../styles/site.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, unknown>[]; // side-specifik struktureret data (FAQ, brødkrummer …)
  lang?: 'da' | 'en';
  // Sprogversioner af samme side (hreflang). Sættes kun på sider, der findes på begge sprog.
  alternates?: { hreflang: string; href: string }[];
}

const { title, description, image, jsonLd = [], lang = 'da', alternates = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ?? new URL(import.meta.env.BASE_URL + 'og-default.png', Astro.site).href;
const base = import.meta.env.BASE_URL;
const home = new URL(base, Astro.site).href;

// Hvem vi er — på hver side, så søgemaskiner og AI-assistenter kan læse det maskinelt.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': home + '#virksomhed',
  name: 'Nem Inventar ApS',
  url: home,
  logo: new URL(base + 'favicon.svg', Astro.site).href,
  image: new URL(base + 'og-default.png', Astro.site).href,
  description:
    'Fast inventar til byggeri — skoler, daginstitutioner, idrætshaller og erhverv. Krydsfiner, kompaktlaminat, linoleum og massivt træ, bygget til mål i egen produktion.',
  telephone: '+45 40 14 05 08',
  email: 'kontakt@neminventar.dk',
  vatID: 'DK45085473',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Mågevej 73, st. tv.',
    postalCode: '2400',
    addressLocality: 'København NV',
    addressCountry: 'DK',
  },
  areaServed: { '@type': 'Country', name: 'Danmark' },
  // Samme virksomhed andre steder — binder profilerne sammen til én enhed for Google og AI-søgning.
  // Tilføj Krak, Proff, Bing Places og LinkedIn her, når de har en fast profil-URL.
  sameAs: ['https://g.page/r/CZTJypcXhpHcEBM'],
  hasMap: 'https://g.page/r/CZTJypcXhpHcEBM',
  knowsAbout: [
    'Krydsfiner-inventar', 'Kompaktlaminat', 'Toiletbåse', 'Garderober', 'Troldegarderober',
    'Lockers', 'Omklædningsbænke', 'Tekøkkener', 'Køkkenøer', 'Siddenicher', 'Akustikpaneler',
    'Glastavler', 'Skoleinventar', 'Inventar til daginstitutioner', 'Inventar til idrætshaller',
  ],
};
const ld = [organization, ...jsonLd];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <meta name="generator" content={Astro.generator} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Nem Inventar" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'da_DK'} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="apple-touch-icon" href={`${base}favicon.svg`} />
  <meta name="theme-color" content="#17140E" />
  {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</head>
<body>
  <Nav />
  <slot />
  <Footer />
</body>
</html>
